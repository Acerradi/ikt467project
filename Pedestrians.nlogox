      <circle x="0" y="0" diameter="300" filled="true" marked="true" color="-1920102913" />
    </shape>
  </turtleShapes>
  <linkShapes />
  <previewCommands>setup repeat 1500 [go]</previewCommands>
  <experiments>
    <experiment name="figure-3-lanes" repetitions="1" sequentialRunOrder="true" runMetricsEveryStep="false" timeLimit="3000">
      <setup>set periodic? true
set population 15 * hall-width
setup</setup>
      <go>go</go>
      <runMetricsCondition>ticks mod 500 = 0</runMetricsCondition>
      <metrics>
        <metric>elapsed-seconds</metric>
        <metric>count pedestrians</metric>
        <metric>pedestrian-density</metric>
        <metric>lane-count</metric>
        <metric>lanes-for-direction 1</metric>
        <metric>lanes-for-direction -1</metric>
        <metric>stat-mean speeds</metric>
        <metric>stat-mean lateral-speeds</metric>
      </metrics>
      <constants>
        <enumeratedValueSet variable="relative-anticipation?">
          <value value="true"></value>
        </enumeratedValueSet>
        <enumeratedValueSet variable="noise-strength">
          <value value="0"></value>
        </enumeratedValueSet>
        <enumeratedValueSet variable="dt">
          <value value="0.02"></value>
        </enumeratedValueSet>
      </constants>
      <subExperiments>
        <subExperiment>
          <steppedValueSet variable="hall-width" first="4" step="2" last="20"></steppedValueSet>
          <enumeratedValueSet variable="simulation-seed">
            <value value="1"></value>
            <value value="2"></value>
            <value value="3"></value>
          </enumeratedValueSet>
        </subExperiment>
      </subExperiments>
    </experiment>
  </experiments>
