    <view x="265" y="10" width="840" height="233" patchSize="16.4" minPxcor="0" maxPxcor="50" minPycor="0" maxPycor="13" wrappingAllowedX="false" wrappingAllowedY="false" frameRate="30" fontSize="12" showTickCounter="true" tickCounterLabel="steps" updateMode="1" />
    <button x="10" y="10" width="75" height="40" display="setup" kind="Observer" forever="false" disableUntilTicks="false">setup</button>
    <button x="90" y="10" width="75" height="40" display="go" kind="Observer" forever="true" disableUntilTicks="true">go</button>
    <button x="170" y="10" width="75" height="40" display="step" kind="Observer" forever="false" disableUntilTicks="true">go</button>
    <slider x="10" y="65" width="235" height="50" display="spawn-rate" variable="spawn-rate" min="0" max="5" step="0.1" default="1" direction="Horizontal" units="attempts/s" />
    <slider x="10" y="125" width="235" height="50" display="dt" variable="dt" min="0.005" max="0.1" step="0.005" default="0.02" direction="Horizontal" units="s" />
    <slider x="10" y="185" width="235" height="50" display="mean-desired-speed" variable="mean-desired-speed" min="0.2" max="2.0" step="0.01" default="1.55" direction="Horizontal" units="m/s" />
    <monitor x="10" y="410" width="115" height="55" display="simulated seconds" precision="2" fontSize="11">elapsed-seconds</monitor>
    <monitor x="130" y="410" width="115" height="55" display="mean speed (m/s)" precision="3" fontSize="11">average-speed</monitor>
    <monitor x="10" y="475" width="115" height="55" display="walking" precision="0" fontSize="11">count pedestrians</monitor>
    <monitor x="130" y="475" width="115" height="55" display="arrived" precision="0" fontSize="11">arrived-count</monitor>
    <note x="275" y="335" width="740" height="80" fontSize="13" markdown="false" backgroundLight="0" backgroundDark="0" textColorLight="-16777216" textColorDark="-1">PERIODIC OR OPEN HALLWAY
Select periodic? and population, then click setup.
Periodic: fixed population, wrapping ends, no new arrivals.
Open: random entries and destinations, controlled by spawn-rate.
The top and bottom walls stay solid in both modes.</note>
    <monitor x="10" y="250" width="235" height="50" display="body radius (m)" precision="2" fontSize="11">body-radius</monitor>
    <slider x="10" y="310" width="235" height="50" display="simulation-seed" variable="simulation-seed" min="0" max="1000" step="1" default="42" direction="Horizontal" units="setup" />
    <switch x="10" y="365" height="35" width="235" on="false" variable="show-trails?" display="show-trails?" />
    <monitor x="10" y="540" width="115" height="55" display="spawned" precision="0" fontSize="11">spawned-count</monitor>
    <monitor x="130" y="540" width="115" height="55" display="blocked arrivals" precision="0" fontSize="11">blocked-spawn-count</monitor>
    <monitor x="275" y="430" width="125" height="55" display="returned at entrance" precision="0" fontSize="11">returned-count</monitor>
    <switch x="420" y="270" width="185" height="40" on="true" variable="periodic?" display="periodic?" />
    <slider x="630" y="270" width="235" height="50" display="population" variable="population" min="2" max="400" step="2" default="150" direction="Horizontal" units="people" />
    <monitor x="275" y="270" width="130" height="55" display="active mode" precision="0" fontSize="11">ifelse-value (active-periodic? = true) ["periodic"] ["open"]</monitor>
    <monitor x="410" y="430" width="125" height="55" display="seam crossings" precision="0" fontSize="11">wrap-count</monitor>
    <monitor x="545" y="430" width="160" height="55" display="density (people/m^2)" precision="3" fontSize="11">pedestrian-density</monitor>
    <slider x="875" y="270" width="230" height="50" variable="desired-speed-sd" display="desired-speed-sd" min="0" max="0.8" step="0.01" default="0.18" direction="Horizontal" units="m/s" />
    <monitor x="715" y="430" width="170" height="55" display="mean desired (m/s)" precision="3" fontSize="11">average-desired-speed</monitor>
    <monitor x="895" y="430" width="170" height="55" display="desired SD (m/s)" precision="3" fontSize="11">desired-speed-spread</monitor>
    <monitor x="275" y="495" width="240" height="40" display="anticipation (s)" precision="2" fontSize="11">anticipation-time</monitor>
    <monitor x="530" y="495" width="180" height="55" display="time gap (s)" precision="2" fontSize="11">avm-time-gap</monitor>
    <note x="725" y="495" width="380" height="80" fontSize="12" markdown="false" textColorLight="-16777216" textColorDark="-1" backgroundLight="0" backgroundDark="0">AVM 2021
Anticipated positions determine direction.
Available headway determines speed.
Radius 0.20 m; no pair position correction.</note>
    <slider x="10" y="605" width="235" height="50" display="hall-width" variable="hall-width" min="2" max="30" step="1" default="10" direction="Horizontal" units="m" />
    <switch x="10" y="665" width="235" height="40" on="false" variable="run-checks?" display="run-checks?" />
    <monitor x="275" y="600" width="125" height="55" display="lanes" precision="0" fontSize="11">lane-count</monitor>
    <monitor x="410" y="600" width="125" height="55" display="overlapping pairs" precision="0" fontSize="11">overlap-pair-count</monitor>
    <monitor x="545" y="600" width="160" height="55" display="pass-throughs (checks)" precision="0" fontSize="11">pass-through-events</monitor>
    <monitor x="715" y="600" width="170" height="55" display="wall penetrations" precision="0" fontSize="11">wall-penetration-count</monitor>
    <monitor x="895" y="600" width="170" height="55" display="min separation seen" precision="3" fontSize="11">ifelse-value (worst-min-separation &gt; 1e8) ["-"] [worst-min-separation]</monitor>
    <plot x="275" y="665" width="410" height="200" display="speed (m/s): mean +/- sd" xAxis="simulated seconds" yAxis="m/s" xMin="0.0" xMax="10.0" yMin="0.0" yMax="1.5" autoPlotX="true" autoPlotY="true" legend="true">
      <setup></setup>
      <update>plot-mean-sd speeds</update>
      <pen display="mean" interval="1.0" mode="0" color="-16777216" legend="true">
        <setup></setup>
        <update></update>
      </pen>
      <pen display="+sd" interval="1.0" mode="0" color="-7500403" legend="true">
        <setup></setup>
        <update></update>
      </pen>
      <pen display="-sd" interval="1.0" mode="0" color="-7500403" legend="true">
        <setup></setup>
        <update></update>
      </pen>
    </plot>
    <plot x="695" y="665" width="410" height="200" display="lanes" xAxis="simulated seconds" yAxis="lanes" xMin="0.0" xMax="10.0" yMin="0.0" yMax="1.5" autoPlotX="true" autoPlotY="true" legend="true">
      <setup></setup>
      <update></update>
      <pen display="lanes" interval="1.0" mode="0" color="-955883" legend="true">
        <setup></setup>
        <update>if stats-sample? [plotxy elapsed-seconds lane-count]</update>
      </pen>
    </plot>
    <monitor x="275" y="880" width="190" height="55" display="integration segments" precision="0" fontSize="11">length last-internal-step-paths</monitor>
    <monitor x="475" y="880" width="190" height="55" display="shortest segment (s)" precision="8" fontSize="11">ifelse-value (empty? last-internal-step-paths) [0] [min map [entry -&gt; item 1 entry] last-internal-step-paths]</monitor>
    <monitor x="275" y="950" width="190" height="55" display="repulsion k" precision="3" fontSize="11">avm-strength</monitor>
    <monitor x="475" y="950" width="190" height="55" display="range D (m)" precision="3" fontSize="11">avm-range</monitor>
    <monitor x="675" y="950" width="190" height="55" display="time gap T (s)" precision="3" fontSize="11">avm-time-gap</monitor>
    <monitor x="875" y="950" width="190" height="55" display="turning tau (s)" precision="3" fontSize="11">tau</monitor>
  </widgets>
  <info><![CDATA[## PEDESTRIANS

A 50 m hallway supports either a fixed periodic population or random arrivals at its open ends. The default 150 people in a 50 by 10 m hallway give density 0.3 people/m^2. Periodic walkers retain their travel direction; open arrivals receive a random destination at the opposite exit. No lanes or preferred passing side are prescribed. This is the project hallway comparison geometry, not a reproduction of the 1995 force-model experiment.

## ANTICIPATION VELOCITY MODEL (AVM)

This model uses Xu, Chraibi and Seyfried (2021), Eqs. (1)-(10).
Pedestrians choose a direction using anticipated neighbour positions, then
select speed from available headway along that direction:

    speed = min(free-speed, max(0, headway / time-gap))

There is no social-force acceleration sum and no stored preferred-velocity
accumulator. The old 1.3-times-desired-speed cap does not apply: the individual
free speed itself is the maximum. Each pedestrian samples free speed once,
using mean 1.55 m/s and standard deviation 0.18 m/s by default. Nonpositive
Gaussian draws are resampled, as in the project initialization.

The Table 3 bidirectional parameter set is used in every scenario:
repulsion strength k = 6, interaction range D = 0.01 m, time-gap T = 0.6 s,
turning time tau = 0.3 s, anticipation time = 0.75 s. Radius r = 0.20 m is
the requested change from the paper's 0.18 m. Thus touching bodies have
a centre distance of 0.4 m. Actual separation is measured, not enforced by
a separate pair constraint. The same radius is used for drawing, pair
headway, wall clearance, door posts and traffic-light stop placement.

There is no pedestrian-pair position projection, hidden overlap correction,
or additional pair repulsion. Pair spacing follows the AVM equations and
the fixed timestep; overlap diagnostics remain observational.
The paper chooses a random side for an exactly aligned predicted neighbour;
this is distinct from the former continuous random-force control.

## WALLS AND SCENARIO BOUNDARIES

The preprint does not specify a wall law. This implementation adds documented
wall gliding inspired by the authors' JuPedSim implementation: within radius
plus a 0.1 m buffer, an inward heading component is removed and a 0.3 outward
component is added before normalization. Wall steering runs BEFORE the final
pedestrian headway speed calculation so its direction is consistent with it.
This ordering is our integration choice, not an exact JuPedSim reproduction.

Wall segments and their round end caps use the pedestrian radius. A swept
geometric bound can only reduce speed along the selected heading; it does
not redirect velocity after pair-speed selection or reposition a pedestrian.
A red stop line uses gap/T and a swept advance bound. No reverse speed or
random creeping is added. Existing geometry, spawning, destinations and
routing are scenario choices, not claims of reproducing the paper's entire
experiment. The crossing remains uncontrolled.

## NUMERICS AND CHECKS

Click setup, then go; click go again to pause. Step advances one interval of
length dt. Heading uses normalized forward Euler, and every pedestrian uses
the same old-state snapshot before all new states are committed. The physical
time-gap, anticipation time and turning time are separate parameters.

There is no added pedestrian-distance limit: no pair position projection,
overlap-based rejection, automatic timestep halving, distance-dependent step
cap or minimum-separation abort. A step is committed even if it produces
overlapping bodies. The experiment measures whether AVM's own direction and
speed equations maintain separation at the chosen dt. The body diameter of
0.4 m remains in the paper's headway formula; it is not an extra acceptance
condition. Smaller fixed timesteps can be compared to measure discretization
sensitivity without imposing a distance threshold.

The traffic-light scenario alone can split an outer interval at its scheduled
light event. Recorded paths include every resulting segment, periodic seams
and pedestrians removed at exits. Door passages are collected chronologically.

With run-checks? on, separation and overlap diagnostics only observe the
generated motion; they never change it or stop a run because people overlap.
check-invariants still validates finite states, wall clearance and the
individual free-speed bound. The existing wall and red-stop boundary rules
remain scenario additions, separate from the pedestrian-pair equations.

Previous results from the version that rejected overlapping steps do not
establish collision avoidance by AVM alone. See AVM.md for the current
unconstrained-pair test protocol and results. Scenario plots and CSV logging
retain their existing sampling cadence.

## SOURCES

Xu, Chraibi and Seyfried (2021), Anticipation in a velocity-based model for
pedestrian dynamics, especially Eqs. (1)-(10) and Table 3:
https://arxiv.org/pdf/2107.00624

Author project explanation distinguishing JuPedSim wall handling:
https://pedestriandynamics.org/models/anticipation_velocity_model/

The JuPedSim implementation also contains a pair buffer and random creep;
those additions are not adopted in this paper-based implementation.
]]></info>
  <turtleShapes>
    <shape name="default" rotatable="false" editableColorIndex="0">
      <circle x="0" y="0" diameter="300" filled="true" marked="true" color="-1920102913" />
    </shape>
    <shape name="circle" rotatable="false" editableColorIndex="0">
      <circle x="0" y="0" diameter="300" filled="true" marked="true" color="-1920102913" />
    </shape>
  </turtleShapes>
  <linkShapes />
  <previewCommands>setup repeat 1500 [go]</previewCommands>
  <experiments>
    <experiment name="figure-3-lanes" repetitions="1" sequentialRunOrder="true" runMetricsEveryStep="false" timeLimit="3000">
      <setup>set periodic? true
set population 15 * hall-width
setup</setup>
      <go>go</go>
      <runMetricsCondition>ticks mod 500 = 0</runMetricsCondition>
      <metrics>
        <metric>elapsed-seconds</metric>
        <metric>count pedestrians</metric>
        <metric>pedestrian-density</metric>
        <metric>lane-count</metric>
        <metric>lanes-for-direction 1</metric>
        <metric>lanes-for-direction -1</metric>
        <metric>stat-mean speeds</metric>
        <metric>stat-mean lateral-speeds</metric>
      </metrics>
      <constants>
        <enumeratedValueSet variable="dt">
          <value value="0.02"></value>
        </enumeratedValueSet>
      </constants>
      <subExperiments>
        <subExperiment>
          <steppedValueSet variable="hall-width" first="4" step="2" last="20"></steppedValueSet>
          <enumeratedValueSet variable="simulation-seed">
            <value value="1"></value>
            <value value="2"></value>
            <value value="3"></value>
          </enumeratedValueSet>
        </subExperiment>
      </subExperiments>
    </experiment>
  </experiments>
</model>
