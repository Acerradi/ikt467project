; =============================================================================
; core/checks.nls -- correctness checks and lane counting
; =============================================================================
; Correctness checks shared by all scenarios. Requires core/pedestrians.nls.
;
; Reporters are usable as monitors, BehaviorSpace metrics and from the Java
; tests. Call checks-reset in setup and checks-update after every ped-step to
; accumulate step-by-step events (pass-throughs, worst values seen).
;
; None of these procedures use random numbers or change pedestrians, so
; turning run-checks? on or off never changes a simulation run.
;
; Lanes follow the project definition: a pedestrian belongs to a lane if its
; shortest distance to the least-squares line through all members of that
; lane is less than lane-max-distance (1.5 m). Lanes are along x, so this is
; for walkways where travel-direction is +1 (right) or -1 (left).

globals [
  check-tolerance          ; numerical slack for the checks (metres, m/s)
  pass-through-events      ; pairs with a deep closest approach during a step
  worst-min-separation     ; smallest centre separation seen so far (m)
  worst-wall-clearance     ; smallest centre-to-wall distance seen so far (m)
  speed-cap-violations     ; pedestrian-steps with |v| > 1.3 v0
  lane-max-distance        ; 1.5 m: lane-membership distance from the project text
  lane-gap                 ; a y-gap larger than this starts a new candidate lane
  lane-min-members         ; smaller groups are not counted as lanes
]

; Reset the accumulators and set the check parameters. Call in setup.
; The "worst" values start at 1e9 so the first real measurement replaces them.
to checks-reset
  set check-tolerance 1e-9
  set pass-through-events 0
  set worst-min-separation 1e9
  set worst-wall-clearance 1e9
  set speed-cap-violations 0
  set lane-max-distance 1.5
  set lane-gap 0.6
  set lane-min-members 5
end

; ---------------------------------------------------------------- per step

; Call once after every ped-step.
; Separation uses both the end-of-step snapshot and the swept paths, so a
; close approach in the middle of a step is not missed.
to checks-update
  set pass-through-events pass-through-events + pass-through-pairs
  set worst-min-separation min (list worst-min-separation min-pair-separation swept-min-pair-separation)
  set worst-wall-clearance min (list worst-wall-clearance min-wall-clearance)
  set speed-cap-violations speed-cap-violations + speed-cap-violation-count
end

; Deep passes during the last step, independent of walking direction. The
; relative path must reach its closest approach during the step, at a centre
; distance below one body-radius. Merely approaching or remaining overlapped
; does not count; overlap-pair-count separately uses the full body diameter.
; Core snapshots actual start/end coordinates before commits/deaths, including
; unwrapped end-x at periodic seams. Velocity cannot reconstruct wall contacts.
to-report pass-through-pairs
  let events 0
  foreach last-step-paths [a ->
    foreach last-step-paths [b ->
      ; item 0 is who; a < b visits each unordered pair once.
      if item 0 a < item 0 b and item 1 (swept-pair-info a b)
        [set events events + 1]
    ]
  ]
  report events
end

; Smallest separation anywhere along the recorded linear motion paths.
; Includes pedestrians that arrived and were removed at the end of the step.
to-report swept-min-pair-separation
  let closest 1e9
  foreach last-step-paths [a ->
    foreach last-step-paths [b ->
      if item 0 a < item 0 b
        [set closest min (list closest item 0 (swept-pair-info a b))]
    ]
  ]
  report closest
end

; Path rows are [who start-x start-y end-x end-y]. Reports [distance deep-pass?].
; Test the fixed periodic images that can be nearest anywhere along the path.
; Applying minimum-image independently to both endpoints could manufacture a
; false crossing when a distant pair crosses half the hallway's circumference.
;
; Both pedestrians move in straight lines during the step, so their relative
; position is q + t * m for t in [0, 1]. The closest approach is at
; t* = -(q . m) / |m|^2, clamped to [0, 1].
to-report swept-pair-info [a b]
  let qx item 1 a - item 1 b                        ; relative start position
  let qy item 2 a - item 2 b
  let move-x (item 3 a - item 1 a) - (item 3 b - item 1 b) ; relative move
  let move-y (item 4 a - item 2 a) - (item 4 b - item 2 b)
  let length-squared move-x * move-x + move-y * move-y
  let first-image 0
  let last-image 0
  if active-periodic? [
    set qx periodic-delta-x qx
    set first-image floor ((- max (list qx (qx + move-x))) / hall-length)
    set last-image ceiling ((- min (list qx (qx + move-x))) / hall-length)
  ]
  let closest 1e9
  let deep-pass? false
  foreach (range first-image (last-image + 1)) [image-index ->
    let image-x qx + image-index * hall-length
    let fraction 0
    if length-squared > 0
      [set fraction (- image-x * move-x - qy * move-y) / length-squared]
    let bounded-fraction max (list 0 (min (list 1 fraction)))
    let separation vector-length (image-x + bounded-fraction * move-x)
                                 (qy + bounded-fraction * move-y)
    set closest min (list closest separation)
    ; Use (0, 1]: a closest approach exactly on a tick boundary belongs to the
    ; step ending there, not also to the following step starting there.
    let fraction-slack 1e-10
    if fraction > fraction-slack and fraction <= 1 + fraction-slack and separation < body-radius
      [set deep-pass? true]
  ]
  report (list closest deep-pass?)
end

; ---------------------------------------------------------------- snapshot

; Smallest centre-to-centre distance between any two pedestrians right now
; (periodic-aware). 1e9 when fewer than two pedestrians exist.
to-report min-pair-separation
  if count pedestrians < 2 [report 1e9]
  let closest 1e9
  let people sort pedestrians
  foreach people [a ->
    foreach people [b ->
      if [who] of a < [who] of b [
        let distance-between [separation-from [xcor] of b [ycor] of b] of a
        set closest min (list closest distance-between)
      ]
    ]
  ]
  report closest
end

; Pairs whose drawn circles (diameter 2 body-radius) overlap now.
to-report overlap-pair-count
  let overlaps 0
  let people sort pedestrians
  foreach people [a ->
    foreach people [b ->
      if [who] of a < [who] of b and
        [separation-from [xcor] of b [ycor] of b] of a < 2 * body-radius
        [set overlaps overlaps + 1]
    ]
  ]
  report overlaps
end

; Smallest distance from any centre to any wall segment.
to-report min-wall-clearance
  if not any? pedestrians or empty? wall-segments [report 1e9]
  report min map [p -> [wall-clearance] of p] sort pedestrians
end

; Distance from the calling pedestrian's centre to the nearest wall segment.
to-report wall-clearance  ; pedestrian reporter
  if empty? wall-segments [report 1e9]
  report min map [wall -> distance-to-segment xcor ycor wall] wall-segments
end

; Distance from point (px, py) to the closest point of a wall segment.
to-report distance-to-segment [px py wall]
  let nearest nearest-point-on-segment px py wall
  report vector-length (px - item 0 nearest) (py - item 1 nearest)
end

; Centres closer to a wall than body-radius: the obstacle was entered.
to-report wall-penetration-count
  report length filter [p -> [wall-clearance] of p < body-radius - check-tolerance] sort pedestrians
end

; The paper's individual cap |v| <= 1.3 v0 (desired speed may be exceeded by
; up to 30 %, never more).
to-report speed-cap-violation-count
  report length filter [p -> [vector-length vx vy > 1.3 * desired-speed + check-tolerance] of p] sort pedestrians
end

; Pedestrians walking faster than their own desired speed right now.
; (Allowed by the model, up to the 1.3 cap; this is an observation, not an error.)
to-report above-desired-speed-count
  report length filter [p -> [vector-length vx vy > desired-speed + check-tolerance] of p] sort pedestrians
end

; Stop with an error if a hard invariant is broken. Use in tests/experiments.
to check-invariants
  if wall-penetration-count > 0 [error (word "Wall penetrated at t = " elapsed-seconds)]
  if speed-cap-violation-count > 0 [error (word "Speed cap exceeded at t = " elapsed-seconds)]
  ; The separation invariant only applies while the hard pair constraint is on.
  if pair-contact-enabled? and
    min (list min-pair-separation swept-min-pair-separation) < minimum-separation - check-tolerance
    [error (word "Minimum pedestrian separation violated at t = " elapsed-seconds)]
end

; ---------------------------------------------------------------- lanes
; Lane counting:
;   1. Take the pedestrians walking in one direction, sorted by y.
;   2. Split them wherever two neighbours in y are more than lane-gap apart.
;   3. Split each group further at its largest y gap until every member is
;      within lane-max-distance of the group's regression line.
;   4. Discard groups with fewer than lane-min-members people.

; Total number of lanes in both directions.
to-report lane-count
  report (lanes-for-direction 1) + (lanes-for-direction -1)
end

; Number of lanes formed by pedestrians with this travel-direction.
to-report lanes-for-direction [direction]
  report length lane-clusters direction
end

; Lists of pedestrians (sorted by y), one list per lane.
to-report lane-clusters [direction]
  ; Sort by y; equal y values are ordered by who, so the result is
  ; deterministic and the same in every run.
  let group sort-by [[a b] -> ifelse-value ([ycor] of a = [ycor] of b)
    [[who] of a < [who] of b] [[ycor] of a < [ycor] of b]]
    filter [p -> [travel-direction] of p = direction] sort pedestrians
  if empty? group [report []]
  ; Candidate lanes: split wherever consecutive y values differ by > lane-gap.
  let candidates []
  let current (list first group)
  foreach but-first group [p ->
    ifelse [ycor] of p - [ycor] of last current > lane-gap
      [set candidates lput current candidates
       set current (list p)]
      [set current lput p current]
  ]
  set candidates lput current candidates
  ; Enforce the 1.5 m definition, then drop groups too small to be lanes.
  ; (reduce sentence flattens the list of lists returned by refine-lane;
  ;  fput [] makes it work for a single candidate too.)
  let lanes reduce sentence (fput [] map [c -> refine-lane c] candidates)
  report filter [c -> length c >= lane-min-members] lanes
end

; Split a candidate at its largest y gap until every member lies within
; lane-max-distance of the cluster's regression line.
; Reports a list of clusters (each a y-sorted list of pedestrians).
to-report refine-lane [members]
  if length members < 2 or max-lane-residual members < lane-max-distance
    [report (list members)]
  ; y gaps between consecutive members; cut after the largest one.
  let gaps (map [[a b] -> [ycor] of b - [ycor] of a] but-last members but-first members)
  let cut 1 + position max gaps gaps
  report sentence refine-lane sublist members 0 cut
                  refine-lane sublist members cut length members
end

; Largest perpendicular distance from a member to the least-squares line
; y = a + b x. On a periodic walkway x is not continuous across the seam, so
; the line is horizontal (b = 0) through the mean y.
to-report max-lane-residual [members]
  let xs map [p -> [xcor] of p] members
  let ys map [p -> [ycor] of p] members
  let mean-y mean ys
  let slope 0
  if not active-periodic? [
    ; Ordinary least squares: b = sum((x - mx)(y - my)) / sum((x - mx)^2).
    let mean-x mean xs
    let sxx sum map [x -> (x - mean-x) ^ 2] xs
    if sxx > 0
      [set slope (sum (map [[x y] -> (x - mean-x) * (y - mean-y)] xs ys)) / sxx]
    set mean-y mean-y - slope * mean-x   ; intercept a
  ]
  ; Vertical residual |y - a - b x| divided by sqrt(1 + b^2) gives the
  ; perpendicular distance to the line.
  report max (map [[x y] -> abs (y - mean-y - slope * x)] xs ys) / sqrt (1 + slope ^ 2)
end
