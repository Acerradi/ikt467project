; =============================================================================
; core/contact.nls -- hard minimum separation between pedestrians
; =============================================================================
; Hard pedestrian clearance, supplementary to the unchanged social forces.
; A simultaneous projection changes candidate motion only when its swept path
; would bring two centres closer than minimum-separation. This is a contact
; constraint, not a reparameterization of the paper's repulsive potential.
;
; Call contact-init after clear-all. Call resolve-pedestrian-contacts after
; every pedestrian has proposed its unwrapped step-end position and before
; finalizing exits, wrapping positions or committing any pedestrian.
;
; How it works, in terms of displacements d_i = (step end) - (step start):
;   1. Start from the proposed displacements d_i^0 (social forces + walls).
;   2. For every pair whose straight relative path would come closer than
;      minimum-separation, add a linear "cut" (half-plane constraint) on
;      d_a - d_b. Pedestrians involved in a cut are "active".
;   3. For active pedestrians, also add cuts for walls and stop lines that
;      their candidate paths touch, and limit each step length to
;      1.3 * desired-speed * dt (the speed cap expressed as a disk).
;   4. Find the displacements closest to d^0 (least total squared change)
;      that satisfy every cut and disk, using Dykstra's alternating
;      projection algorithm.
;   5. The corrected paths may create new contacts; add any new cuts and
;      solve again from d^0. Stop when no new cuts appear.
; Pedestrians whose motion did not change keep their original buffers
; bit-for-bit, so free walkers are unaffected by the solver.

globals [
  pair-contact-enabled?          ; master switch; true in production runs
  minimum-separation             ; required centre-to-centre distance (m)
  contact-step-count             ; steps whose candidate paths required correction
  contact-solver-fallbacks       ; bounded solver could not finish: whole step held
  contact-last-iterations        ; projection sweeps used in the last step
  contact-last-constraints       ; number of cuts in the last step
  contact-constraints           ; [agent-a agent-b-or-false nx ny rhs Dykstra-scalar]
]

; Each cut [a b nx ny rhs lambda] encodes, with n = (nx, ny):
;   pair cut  (b is a pedestrian):  n . (d_a - d_b) >= rhs
;   boundary  (b = false):          n . d_a        >= rhs
; lambda >= 0 is the cut's accumulated Dykstra correction (see below).

pedestrians-own [
  contact-dx contact-dy                     ; current trial displacement this step
  contact-original-dx contact-original-dy   ; proposed displacement d^0
  contact-disk-cx contact-disk-cy           ; Dykstra correction of the speed disk
  contact-iteration-dx contact-iteration-dy ; displacement at start of a sweep
  contact-active?                           ; takes part in at least one cut
]

; Defaults and counters. Called from ped-init-constants after clear-all.
to contact-init
  set pair-contact-enabled? true
  set minimum-separation 0.5
  set contact-step-count 0
  set contact-solver-fallbacks 0
  set contact-last-iterations 0
  set contact-last-constraints 0
  set contact-constraints []
end

; Enforce minimum-separation on this step's candidate paths (see header).
to resolve-pedestrian-contacts
  set contact-last-iterations 0
  set contact-last-constraints 0
  set contact-constraints []
  if not pair-contact-enabled? [stop]
  if minimum-separation <= 0 [error "minimum-separation must be positive when pair contact is enabled."]
  let people sort pedestrians
  if length people < 2 [stop]
  ; Read every proposed displacement from the buffers written by
  ; propose-next-state (step-end is unwrapped, so seams need no special care).
  foreach people [p -> ask p [
    set contact-dx step-end-x - xcor
    set contact-dy step-end-y - ycor
    set contact-original-dx contact-dx
    set contact-original-dy contact-dy
    set contact-active? false
  ]]
  contact-add-pair-cuts people
  ; Exact original buffers, including preferred velocity, survive free motion.
  if empty? contact-constraints [stop]
  set contact-step-count contact-step-count + 1

  ; Cutting-plane loop: solve, look for new contacts on the corrected paths,
  ; add their cuts, solve again. Bounded to 40 rounds.
  let finished? false
  let failed? false
  let rounds 0
  contact-add-boundary-cuts people
  while [not finished? and not failed?] [
    let solved? contact-project-motions people
    set rounds rounds + 1
    ifelse solved? [
      let old-count length contact-constraints
      contact-add-pair-cuts people
      contact-add-boundary-cuts people
      ; No new constraint was violated: the corrected paths are safe.
      if length contact-constraints = old-count [set finished? true]
      if rounds >= 40 and not finished? [set failed? true]
    ] [set failed? true]
  ]
  set contact-last-constraints length contact-constraints
  ifelse failed? [
    ; Every valid old configuration is feasible. Never accept an unsafe
    ; unconverged result: hold this step and record the numerical fallback.
    set contact-solver-fallbacks contact-solver-fallbacks + 1
    foreach people [p -> ask p [
      set step-end-x xcor
      set step-end-y ycor
      set next-x xcor
      set next-y ycor
      set next-vx 0
      set next-vy 0
      set next-wx 0
      set next-wy 0
    ]]
  ] [
    ; Write the corrected displacements back into the step buffers, but only
    ; for pedestrians the solver actually moved.
    foreach people [p -> ask p [
      if contact-dx != contact-original-dx or contact-dy != contact-original-dy [
        set step-end-x xcor + contact-dx
        set step-end-y ycor + contact-dy
        set next-x step-end-x
        set next-y step-end-y
        ; Corrected displacement defines the step's actual velocity. The
        ; projected speed disk ensures the unchanged cap relation with w=v.
        set next-vx contact-dx / dt
        set next-vy contact-dy / dt
        set next-wx next-vx
        set next-wy next-vy
      ]
    ]]
  ]
end

; Add one supporting plane for the first unsafe periodic image of each pair.
; The initial configuration is checked even if no contact will occur.
; Pairs that already have a cut are tested again; a satisfied pair yields
; no new cut, so the constraint count only grows for genuinely new contacts.
to contact-add-pair-cuts [people]
  foreach range length people [i ->
    let a item i people
    foreach (range (i + 1) (length people)) [j ->
      let b item j people
      let cut contact-pair-cut a b
      if cut != false [
        set contact-constraints lput cut contact-constraints
        ask a [set contact-active? true]
        ask b [set contact-active? true]
      ]
    ]
  ]
end

; Each constraint has n dot (d_a - d_b) >= minimum-separation - n dot q_0.
; Its normal is taken at first contact on the proposed relative path. Thus
; both the old relative position and every corrected path endpoint lie on
; the safe side of the same circle tangent, protecting the entire step.
;
; Geometry: in the frame of b, a moves along the segment q -> q + m, with
; q = x_a - x_b and m = d_a - d_b. The forbidden region is the disk of
; radius minimum-separation around the origin. If the segment enters the
; disk, take the first entry point p* and its unit normal n = p*/|p*|.
; The tangent line n . p = s separates the disk from q, and the half-plane
; n . p >= s is convex, so any corrected segment with both ends on that side
; stays outside the disk for the whole step.
;
; Reports the cut [a b nx ny rhs 0], or false when the pair stays clear.
to-report contact-pair-cut [a b]
  let qx [xcor] of a - [xcor] of b
  if active-periodic? [set qx periodic-delta-x qx]
  let qy [ycor] of a - [ycor] of b
  let initial-distance vector-length qx qy
  if initial-distance < minimum-separation - 1e-9 [
    error (word "Pedestrians " [who] of a " and " [who] of b
      " start closer than minimum-separation. Run setup or use valid initial placement.")
  ]
  let move-x [contact-dx] of a - [contact-dx] of b
  let move-y [contact-dy] of a - [contact-dy] of b
  let movement-squared move-x * move-x + move-y * move-y
  if movement-squared = 0 [report false]    ; no relative motion: stays as is
  ; Quick reject: the relative move is too short to close the gap.
  if initial-distance >= minimum-separation + sqrt movement-squared [report false]
  let first-image 0
  let last-image 0
  if active-periodic? [
    ; Fixed images, including every image a long unwrapped path can approach.
    set first-image floor ((- max (list qx (qx + move-x)) - minimum-separation) / hall-length)
    set last-image ceiling ((- min (list qx (qx + move-x)) + minimum-separation) / hall-length)
  ]
  let best false
  let earliest 2                 ; any real contact fraction is <= 1
  foreach (range first-image (last-image + 1)) [image-index ->
    let image-x qx + image-index * hall-length
    ; Closest approach of the relative segment to the origin.
    let dot-product image-x * move-x + qy * move-y
    let fraction max (list 0 (min (list 1 (- dot-product / movement-squared))))
    let closest vector-length (image-x + fraction * move-x) (qy + fraction * move-y)
    if closest < minimum-separation - 1e-9 [
      ; First time t with |q + t m| = s: smaller root of
      ;   |m|^2 t^2 + 2 (q . m) t + (|q|^2 - s^2) = 0.
      let start-squared image-x * image-x + qy * qy
      let constant start-squared - minimum-separation * minimum-separation
      let hit-fraction 0
      if constant > 0 [
        let discriminant max (list 0 (dot-product * dot-product - movement-squared * constant))
        ; Stable form of the first quadratic root for an approaching pair.
        set hit-fraction constant / (- dot-product + sqrt discriminant)
      ]
      ; Keep the image that is hit first.
      if hit-fraction < earliest [
        let nx image-x + hit-fraction * move-x
        let ny qy + hit-fraction * move-y
        let normal-length vector-length nx ny
        set nx nx / normal-length
        set ny ny / normal-length
        ; n . (q + d_a - d_b) >= s  rewritten as  n . (d_a - d_b) >= s - n . q
        let rhs minimum-separation - nx * image-x - ny * qy
        set best (list a b nx ny rhs 0)
        set earliest hit-fraction
      ]
    ]
  ]
  report best
end

; Pair correction can push someone towards a wall or red line. These cuts
; join the same simultaneous solve; applying a later independent clamp could
; otherwise reintroduce a pair overlap.
; Uses the same swept capsule test as apply-wall-contact, rewritten for the
; displacement: n . (x_old + d) >= c  becomes  n . d >= c - n . x_old.
to contact-add-boundary-cuts [people]
  foreach people [p ->
    if [contact-active?] of p [
      let old-x [xcor] of p
      let old-y [ycor] of p
      let end-x old-x + [contact-dx] of p
      let end-y old-y + [contact-dy] of p
      foreach wall-segments [wall ->
        let hit swept-wall-contact old-x old-y end-x end-y wall
        if hit != false [
          let nx item 1 hit
          let ny item 2 hit
          let rhs item 3 hit - nx * old-x - ny * old-y
          set contact-constraints lput (list p false nx ny rhs 0) contact-constraints
        ]
      ]
      ; Red stop line: the endpoint must stay behind stop-x.
      let stop-line [stop-x] of p
      if is-number? stop-line [
        let nx (- [travel-direction] of p)
        if nx * end-x < nx * stop-line - 1e-10 [
          let rhs nx * (stop-line - old-x)
          set contact-constraints lput (list p false nx 0 rhs 0) contact-constraints
        ]
      ]
    ]
  ]
end

; Euclidean projection of all candidate displacements onto the accumulated
; half-planes and speed disks, using Dykstra's correction vectors. Pair planes
; share their correction equally: |(n,-n)|^2=2. Wall/stop planes have norm 1.
; Solve again from the original proposals when new cuts have been discovered.
;
; Dykstra's algorithm projects onto each convex set in turn, but before each
; projection it first adds back the correction that set made in the previous
; sweep. Unlike plain alternating projection, this converges to the point of
; the intersection CLOSEST to the start, i.e. the smallest total change.
; For a half-plane the stored correction is the scalar lambda (item 5 of the
; cut); for the speed disk it is the vector (contact-disk-cx, contact-disk-cy).
; Reports true when the sweeps converged within 2000 iterations.
to-report contact-project-motions [people]
  ; Restart from the original proposals with zero corrections.
  foreach people [p -> ask p [
    set contact-dx contact-original-dx
    set contact-dy contact-original-dy
    set contact-disk-cx 0
    set contact-disk-cy 0
  ]]
  set contact-constraints map [cut -> replace-item 5 cut 0] contact-constraints
  let iterations 0
  let converged? false
  while [not converged? and iterations < 2000] [
    ; Remember where this sweep started, to measure how much it moved.
    foreach people [p -> if [contact-active?] of p [ask p [
      set contact-iteration-dx contact-dx
      set contact-iteration-dy contact-dy
    ]]]
    ; --- half-plane cuts (pairs, walls, stop lines) ---
    let index 0
    foreach contact-constraints [cut ->
      let a item 0 cut
      let b item 1 cut
      let nx item 2 cut
      let ny item 3 cut
      let old-correction item 5 cut
      ; Undo this cut's previous correction (the Dykstra step).
      let a-x [contact-dx] of a - old-correction * nx
      let a-y [contact-dy] of a - old-correction * ny
      let b-x 0
      let b-y 0
      let norm-squared 1
      if b != false [
        set b-x [contact-dx] of b + old-correction * nx
        set b-y [contact-dy] of b + old-correction * ny
        set norm-squared 2
      ]
      ; Project onto the half-plane: push along n only by the amount the cut
      ; is violated (never negative: a satisfied cut leaves motion unchanged).
      ; A pair splits the push equally: a moves +n, b moves -n.
      let correction max (list 0 ((item 4 cut - nx * (a-x - b-x) - ny * (a-y - b-y)) / norm-squared))
      ask a [
        set contact-dx a-x + correction * nx
        set contact-dy a-y + correction * ny
      ]
      if b != false [ask b [
        set contact-dx b-x - correction * nx
        set contact-dy b-y - correction * ny
      ]]
      set contact-constraints replace-item index contact-constraints (replace-item 5 cut correction)
      set index index + 1
    ]
    ; --- speed disks |d| <= 1.3 * desired-speed * dt (the individual cap) ---
    foreach people [p -> if [contact-active?] of p [ask p [
      ; Undo the previous disk correction, project radially onto the disk,
      ; and store the new correction.
      let dx-before contact-dx + contact-disk-cx
      let dy-before contact-dy + contact-disk-cy
      let motion-length vector-length dx-before dy-before
      let factor 1
      if motion-length > 0 [set factor min (list 1 (1.3 * desired-speed * dt / motion-length))]
      set contact-dx factor * dx-before
      set contact-dy factor * dy-before
      set contact-disk-cx dx-before - contact-dx
      set contact-disk-cy dy-before - contact-dy
    ]]]
    ; Converged when a whole sweep barely moves anyone and no cut is violated.
    let largest-change 0
    foreach people [p -> if [contact-active?] of p [
      set largest-change max (list largest-change
        [vector-length (contact-dx - contact-iteration-dx) (contact-dy - contact-iteration-dy)] of p)
    ]]
    if largest-change <= 1e-11 and contact-largest-violation <= 1e-11 [set converged? true]
    set iterations iterations + 1
  ]
  set contact-last-iterations contact-last-iterations + iterations
  report converged?
end

; Largest amount (m) by which any cut is currently violated; 0 if none is.
to-report contact-largest-violation
  let worst 0
  foreach contact-constraints [cut ->
    let a item 0 cut
    let b item 1 cut
    let relative-x [contact-dx] of a
    let relative-y [contact-dy] of a
    if b != false [
      set relative-x relative-x - [contact-dx] of b
      set relative-y relative-y - [contact-dy] of b
    ]
    set worst max (list worst (item 4 cut - item 2 cut * relative-x - item 3 cut * relative-y))
  ]
  report worst
end
