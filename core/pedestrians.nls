; AVM: Xu, Chraibi & Seyfried (2021), Eqs. (1)-(10).
; Position in metres, speed in m/s, times in seconds. Shared by all scenarios.
; Actual heading is an independent state even when speed is zero. Steering,
; heading relaxation and the gap-based speed law are in avm.nls. There is no
; social-force acceleration integration and no pedestrian position projection.
; Boundaries/routing are explicit project additions; see AVM.md.
;
; Widget contract: dt, mean-desired-speed, desired-speed-sd, show-trails?.
; Model hook: scenario-exit-check acts on accepted next-x/next-y only.
; All agents use one immutable old-state snapshot per internal Euler step.

breed [pedestrians pedestrian]

globals [
  tau anticipation-time avm-strength avm-range avm-time-gap
  epsilon arrival-radius wall-segments elapsed-seconds arrived-count
  spawned-count blocked-spawn-count entrance-clearance
  hall-bottom hall-top body-radius returned-count hall-length active-periodic? wrap-count
  open-left open-right waypoint-radius stop-speed travel-times arrival-slow-seconds
  last-step-paths last-step-start-seconds last-step-duration last-internal-step-paths
  avm-accepted-steps avm-rejected-steps avm-last-min-step
  avm-reverse-calculation? avm-wall-buffer
  ; Compatibility fields for existing scenario commands/diagnostics only.
  ; These do not select another model or activate pair contact in AVM.
  noise-strength relative-anticipation? active-relative-anticipation?
  pair-contact-enabled? minimum-separation contact-step-count contact-solver-fallbacks
]

pedestrians-own [
  desired-speed goal-x goal-y ex ey move-ex move-ey
  vx vy ax ay wx wy noise-unit-x noise-unit-y
  next-vx next-vy next-wx next-wy next-x next-y next-move-ex next-move-ey
  reached-goal? returned? travel-direction next-wrap-count waypoints stop-x stop-y drive-factor
  birth-seconds started? slow-seconds previous-x previous-y step-end-x step-end-y
  avm-ties avm-neighbor-rows
]

to ped-init-constants
  ; Table 3 calibrated bidirectional settings; radius changed at user request.
  set avm-strength 6
  set avm-range 0.01
  set avm-time-gap 0.6
  set tau 0.3
  set anticipation-time 0.75
  set body-radius 0.2
  set epsilon 1e-12
  set entrance-clearance 0.6
  set arrival-radius 0.3
  set waypoint-radius 0.5
  set stop-speed 0.1
  set avm-wall-buffer 0.1
  set avm-reverse-calculation? false
  set avm-accepted-steps 0
  set avm-rejected-steps 0
  set avm-last-min-step dt
  set active-periodic? false
  set wall-segments []
  set travel-times []
  set arrival-slow-seconds []
  set last-step-paths []
  set last-internal-step-paths []
  set last-step-start-seconds 0
  set last-step-duration 0
  set noise-strength 0
  set relative-anticipation? true
  set active-relative-anticipation? true
  set pair-contact-enabled? false
  set minimum-separation 2 * body-radius
  set contact-step-count 0
  set contact-solver-fallbacks 0
end

to ped-check-parameters
  if dt <= 0 or tau <= 0 or avm-time-gap <= 0 or avm-range <= 0 or body-radius <= 0
    [error "AVM timestep, turning time, time gap, interaction range and radius must be positive."]
  if anticipation-time < 0 or avm-strength < 0 or avm-wall-buffer < 0
    [error "AVM anticipation, steering strength and wall buffer must be nonnegative."]
  if pair-contact-enabled? [error "AVM uses body size in its speed law; the legacy pair projection must stay disabled."]
  if noise-strength != 0 [error "AVM has no random force. Only the paper's aligned-encounter side choice is random."]
end

to-report placement-clearance
  report max (list entrance-clearance (2 * body-radius + 1e-9))
end

to-report ped-clear-at? [px py]
  let clearance placement-clearance
  if any? pedestrians with [separation-from px py < clearance] [report false]
  foreach wall-segments [wall ->
    let nearest nearest-point-on-segment px py wall
    if vector-length (px - item 0 nearest) (py - item 1 nearest) < body-radius [report false]
  ]
  report true
end

to initialize-pedestrian [initial-x initial-y target-x target-y assigned-direction]
  set shape "circle"
  set size 2 * body-radius
  setxy initial-x initial-y
  set goal-x target-x
  set goal-y target-y
  set travel-direction assigned-direction
  set desired-speed sample-desired-speed
  set color ifelse-value (travel-direction = 1) [orange + 1] [blue]
  set reached-goal? false
  set returned? false
  set waypoints []
  set stop-x false
  set stop-y false
  set birth-seconds elapsed-seconds
  set started? false
  set slow-seconds 0
  set previous-x xcor
  set previous-y ycor
  set step-end-x xcor
  set step-end-y ycor
  set avm-ties []
  set avm-neighbor-rows []
  set pen-size 1
  pen-up
  update-desired-direction
  set move-ex ex
  set move-ey ey
  if vector-length move-ex move-ey = 0 [set move-ex assigned-direction]
  set heading atan move-ex move-ey
  ; Start at rest; Eq. (10) sets the speed at the first update.
end

to-report sample-desired-speed
  if mean-desired-speed <= 0 or desired-speed-sd < 0
    [error "Mean desired speed must be positive; its SD must be nonnegative."]
  let sampled-speed random-normal mean-desired-speed desired-speed-sd
  while [sampled-speed <= 0] [set sampled-speed random-normal mean-desired-speed desired-speed-sd]
  report sampled-speed
end

to update-desired-direction
  set drive-factor 1
  if active-periodic? [set ex travel-direction set ey 0 stop]
  while [not empty? waypoints and
    vector-length (item 0 first waypoints - xcor) (item 1 first waypoints - ycor) < waypoint-radius]
    [set waypoints but-first waypoints]
  let target-x goal-x
  let target-y goal-y
  if not empty? waypoints [set target-x item 0 first waypoints set target-y item 1 first waypoints]
  let distance-to-goal vector-length (target-x - xcor) (target-y - ycor)
  ifelse distance-to-goal > epsilon [
    set ex (target-x - xcor) / distance-to-goal
    set ey (target-y - ycor) / distance-to-goal
  ] [set ex 0 set ey 0]
end

to-report avm-snapshot
  report map [p -> [(list who xcor ycor vx vy move-ex move-ey ex ey desired-speed)] of p] sort pedestrians
end

; One fixed Euler interval. No pedestrian-distance acceptance test, retry,
; position projection, or collision-triggered timestep change is applied.
; TrafficLight may split an outer tick only at a scheduled light event.
to ped-step
  ped-check-parameters
  let step-size dt
  let start-time elapsed-seconds
  let people sort pedestrians
  foreach people [p -> ask p [update-desired-direction]]
  let states avm-snapshot
  ; Assign the paper's aligned-pair side choices before calculating agents.
  ; Canonical order keeps the result independent of actor evaluation order.
  (foreach people states [[p row] ->
    let visible-rows avm-unoccluded-neighbors row states
    let choices map [identity -> (list identity (ifelse-value (random 2 = 0) [-1] [1]))]
      (avm-tie-neighbors row visible-rows)
    ask p [set avm-ties choices set avm-neighbor-rows visible-rows]
  ])
  let calculation-order ifelse-value avm-reverse-calculation? [reverse people] [people]
  foreach calculation-order [p -> ask p [
    let row item (position self people) states
    let direction avm-steering row avm-neighbor-rows step-size avm-ties
    let wall-direction avm-wall-heading xcor ycor (item 0 direction) (item 1 direction)
    let magnitude vector-length (item 0 wall-direction) (item 1 wall-direction)
    let speed 0
    ifelse magnitude > 0 [
      set next-move-ex item 0 wall-direction
      set next-move-ey item 1 wall-direction
      set speed avm-speed row avm-neighbor-rows next-move-ex next-move-ey
      set speed avm-boundary-speed xcor ycor next-move-ex next-move-ey speed step-size stop-x travel-direction
      ; The crossing controller uses the same existing stop-line rule on y.
      ; This limits admission at a gate, not pedestrian-pair separation.
      if is-number? stop-y [
        set speed avm-axis-stop-speed ycor next-move-ey speed step-size stop-y travel-direction
      ]
    ] [set next-move-ex item 0 direction set next-move-ey item 1 direction]
    if ex = 0 and ey = 0 [set speed 0]
    set next-vx next-move-ex * speed
    set next-vy next-move-ey * speed
    set next-wx next-vx
    set next-wy next-vy
    set previous-x xcor
    set previous-y ycor
    set next-wrap-count 0
    set next-x xcor + step-size * next-vx
    set next-y ycor + step-size * next-vy
    set step-end-x next-x
    set step-end-y next-y
  ]]
  set last-step-start-seconds start-time
  set last-step-duration step-size
  set last-step-paths map [p -> [(list who previous-x previous-y step-end-x step-end-y)] of p] people
  let endpoints map [p -> [(list who step-end-x step-end-y next-vx next-vy next-move-ex next-move-ey desired-speed)] of p] people
  set last-internal-step-paths lput (list start-time step-size last-step-paths endpoints) last-internal-step-paths
  ; Commit even if the paper's motion produces body overlap. Diagnostics
  ; measure that result; they must not censor or repair this experiment.
  foreach people [p -> ask p [
    set ax (next-vx - vx) / step-size
    set ay (next-vy - vy) / step-size
    finalize-next-state
  ]]
  foreach people [p -> ask p [commit-next-state]]
  set elapsed-seconds start-time + step-size
  set avm-accepted-steps avm-accepted-steps + 1 ; committed intervals, legacy name
  set avm-last-min-step step-size
  ; avm-rejected-steps remains zero: no rejection branch exists.
  tick
end

to finalize-next-state
  if active-periodic? [
    ; Count how many periods the move crossed, then wrap x into [0, hall-length).
    set next-wrap-count abs (floor (next-x / hall-length))
    set next-x next-x mod hall-length
    ; Nobody arrives or leaves on a periodic walkway.
    set reached-goal? false
    set returned? false
    stop
  ]

  ; Arrive if this step's path enters the goal disk, even if it overshoots.
  ; (Testing only the endpoint could let a fast walker jump over the disk.)
  let path (list xcor ycor next-x next-y)
  let closest nearest-point-on-segment goal-x goal-y path
  set reached-goal? (vector-length (goal-x - item 0 closest)
                                    (goal-y - item 1 closest)) <= arrival-radius
  set returned? false
  ; Scenario-specific exits (e.g. crossing an exit plane), defined by the model.
  scenario-exit-check
end

to commit-next-state
  if reached-goal? [
    set arrived-count arrived-count + 1
    ; Arrival happens during this step, so it completes at elapsed-seconds + dt.
    set travel-times lput (elapsed-seconds + dt - birth-seconds) travel-times
    set arrival-slow-seconds lput slow-seconds arrival-slow-seconds
    die
  ]
  if returned? [
    set returned-count returned-count + 1
    die
  ]
  set move-ex next-move-ex
  set move-ey next-move-ey
  set wx next-wx
  set wy next-wy
  set vx next-vx
  set vy next-vy
  ; Stopping statistics (bookkeeping only; does not affect motion).
  ; A pedestrian counts as "started" once it first reaches half its desired
  ; speed; afterwards every step spent below stop-speed adds to slow-seconds.
  let speed vector-length vx vy
  ifelse speed >= 0.5 * desired-speed
    [set started? true]
    [if started? and speed < stop-speed [set slow-seconds slow-seconds + dt]]
  set wrap-count wrap-count + next-wrap-count
  ; Do not draw a false line across the entire view when crossing the seam.
  ifelse show-trails? and next-wrap-count = 0 [pen-down] [pen-up]
  setxy next-x next-y
  ; Face the direction of motion; keep the old heading when (nearly) still.
  if vector-length vx vy > epsilon [set heading atan vx vy]
end

to-report periodic-delta-x [delta-x]
  ; Minimum-image displacement, using the same period as position wrapping.
  ; Maps any delta-x into [-hall-length/2, hall-length/2).
  report ((delta-x + hall-length / 2) mod hall-length) - hall-length / 2
end

; Centre distance from the calling pedestrian to the point (px, py),
; using the nearest periodic image when the walkway is periodic.
to-report separation-from [px py]
  let delta-x xcor - px
  if active-periodic? [set delta-x periodic-delta-x delta-x]
  report vector-length delta-x (ycor - py)
end

; Euclidean length of the vector (delta-x, delta-y).
to-report vector-length [delta-x delta-y]
  report sqrt (delta-x * delta-x + delta-y * delta-y)
end

; Closest point to (px, py) on segment [x1 y1 x2 y2]: project onto the line,
; then clamp the line parameter to [0, 1] so the point stays on the segment.
to-report nearest-point-on-segment [px py segment]
  let x1 item 0 segment
  let y1 item 1 segment
  let delta-x (item 2 segment) - x1
  let delta-y (item 3 segment) - y1
  let length-squared delta-x * delta-x + delta-y * delta-y
  if length-squared = 0 [report (list x1 y1)]   ; degenerate segment = point
  let fraction ((px - x1) * delta-x + (py - y1) * delta-y) / length-squared
  set fraction max (list 0 (min (list 1 fraction)))
  report (list (x1 + fraction * delta-x) (y1 + fraction * delta-y))
end

; ---------------------------------------------------------------- monitors
; Population summaries for interface monitors. Sorted lists are used so the
; results never depend on (or consume) NetLogo's random agentset order.

; Mean actual speed |v| over all pedestrians (0 when the world is empty).
to-report average-speed
  if not any? pedestrians [report 0]
  report mean map [p -> [vector-length vx vy] of p] sort pedestrians
end

; Mean desired speed v0 of the pedestrians currently present.
to-report average-desired-speed
  if not any? pedestrians [report 0]
  report mean map [p -> [desired-speed] of p] sort pedestrians
end

; Sample standard deviation of the present desired speeds.
to-report desired-speed-spread
  if count pedestrians < 2 [report 0]
  report standard-deviation map [p -> [desired-speed] of p] sort pedestrians
end

; ---------------------------------------------------------------- scenario helpers

; Try up to attempts candidate positions from candidate (an anonymous reporter
; giving [x y]); report the first one that keeps entrance-clearance, or false.
to-report try-place [candidate attempts]
  repeat attempts [
    let spot runresult candidate
    if ped-clear-at? item 0 spot item 1 spot [report spot]
  ]
  report false
end

; Uniform random number in [low, high).
to-report random-between [low high]
  report low + random-float (high - low)
end

; Standard exit rule for a walkway along x, usable as scenario-exit-check:
; arrive on crossing the far exit plane (open-right when walking right,
; open-left when walking left); pushed back through the entrance = returned.
to x-walkway-exit-check
  if (travel-direction = 1 and next-x >= open-right) or
     (travel-direction = -1 and next-x <= open-left)
    [set reached-goal? true]
  set returned? ((travel-direction = 1 and next-x < open-left) or
                 (travel-direction = -1 and next-x > open-right))
end

; Draw every wall segment into the drawing layer (patches are 1 m, too
; coarse for door posts). Trails share this layer; setup's clear-all clears it.
; A temporary turtle walks along each segment with its pen down, then dies.
to draw-walls [wall-color]
  create-turtles 1 [
    set color wall-color
    set pen-size 3
    foreach wall-segments [wall ->
      pen-up
      setxy item 0 wall item 1 wall
      pen-down
      setxy item 2 wall item 3 wall
    ]
    die
  ]
end
