; Pedestrian social-force core, shared by every scenario model via __includes.
; Coordinates: metres. Velocity: m/s. Acceleration: m/s^2.
;
; This file never defines setup or go: each scenario model owns those and
; calls ped-init-constants, ped-check-parameters and ped-step.
;
; Interface contract. These names are USED here but must be DECLARED by the
; including model, either as a widget or in its own globals [...]:
;   dt, mean-desired-speed, desired-speed-sd, noise-strength,
;   relative-anticipation?, show-trails?
;
; Required hook. Every including model must define this procedure. It runs in
; pedestrian context inside finalize-next-state, after joint contact and the goal-disk test,
; and may set reached-goal? (left successfully) or returned? (left backwards)
; from the buffered next-x/next-y:
;   to scenario-exit-check ... end
;
; Geometry is data: wall-segments is a list of [x1 y1 x2 y2] segments. Each
; one exerts the wall force and is impenetrable to a pedestrian's centre
; closer than body-radius (apply-wall-contact). Optional x-periodicity:
; set active-periodic? true and hall-length to the period.
;
; Per-pedestrian steering options (set by scenarios, off by default):
;   waypoints  list of [x y] visited in order before goal-x/goal-y
;   stop-x     false, or an x the pedestrian brakes to and waits at

breed [pedestrians pedestrian]

globals [
  tau anticipation-time potential-strength sigma
  wall-strength wall-range view-half-angle rear-weight
  epsilon arrival-radius wall-segments elapsed-seconds arrived-count
  spawned-count blocked-spawn-count entrance-clearance
  hall-bottom hall-top body-radius returned-count
  hall-length active-periodic? wrap-count
  open-left open-right active-relative-anticipation?
  waypoint-radius stop-speed
  travel-times arrival-slow-seconds   ; one entry per arrived pedestrian
  last-step-paths                    ; [who start-x start-y unwrapped-end-x end-y]
  last-step-start-seconds last-step-duration
]

pedestrians-own [
  desired-speed                ; v_i^0, sampled once at creation and retained
  goal-x goal-y                 ; destination x_i^0
  ex ey                         ; desired unit direction e_i
  wx wy                         ; preferred velocity w_i (kept between steps)
  vx vy                         ; actual, speed-limited velocity v_i
  ax ay                         ; acceleration dw_i/dt
  noise-unit-x noise-unit-y     ; random unit direction, sampled once at setup
  next-wx next-wy next-vx next-vy next-x next-y
  reached-goal?
  returned?
  travel-direction             ; +1 right, -1 left; fixed for each pedestrian
  next-wrap-count              ; buffered seam crossings, committed once per step
  waypoints                    ; remaining [x y] waypoints before the goal
  stop-x                       ; false, or x-coordinate to stop at (e.g. red light)
  drive-factor                 ; scales desired speed near stop-x; otherwise 1
  birth-seconds                ; creation time, for travel times
  started?                     ; has reached half its desired speed once
  slow-seconds                 ; time spent below stop-speed after starting
  previous-x previous-y         ; physical position before this integration step
  step-end-x step-end-y         ; corrected endpoint before periodic wrapping
]

; Physical and numerical constants. Call after clear-all in every scenario setup.
to ped-init-constants
  ; Example settings for quantities left unspecified in the report.
  set tau 0.5
  set anticipation-time 2       ; T in seconds, independent of numerical step dt
  set potential-strength 2.1   ; V^0, units m^2/s^2
  set sigma 0.3                ; interaction range, metres
  set view-half-angle 100      ; phi; NetLogo trigonometry uses degrees
  set rear-weight 0.5          ; c
  set epsilon 0.000001         ; length softening at singular geometries
  set arrival-radius 0.3       ; metres
  set entrance-clearance 0.6   ; minimum initial separation at an entrance
  set body-radius 0.2          ; hard wall clearance; social forces are unchanged
  ; Equation (4): values explicitly given in your report.
  set wall-strength 50
  set wall-range 0.2
  set active-relative-anticipation? relative-anticipation? ; fixed on setup
  ; Scenario-independent defaults; scenarios override after this call.
  set active-periodic? false
  set wall-segments []
  set waypoint-radius 0.5      ; a waypoint counts as passed within this distance
  set stop-speed 0.1           ; below this speed (m/s) a pedestrian counts as stopped
  set travel-times []
  set arrival-slow-seconds []
  set last-step-paths []
  set last-step-start-seconds 0
  set last-step-duration 0
  contact-init
end

; True when a new pedestrian centred at (px, py) keeps entrance-clearance
; from everyone already present (periodic-aware).
to-report ped-clear-at? [px py]
  let clearance placement-clearance
  report not any? pedestrians with [separation-from px py < clearance]
end

to-report placement-clearance
  if not pair-contact-enabled? [report entrance-clearance]
  report max (list entrance-clearance minimum-separation)
end

to ped-check-parameters
  if dt <= 0 or tau <= 0 or sigma <= 0 or wall-range <= 0
    [error "dt, tau, sigma and wall-range must be positive."]
end

; One integration step for all pedestrians.
to ped-step
  set last-step-start-seconds elapsed-seconds
  set last-step-duration dt
  ; Separate passes ensure everyone uses the same time-t state. Resolve contact
  ; jointly on candidate paths before checking exits or committing any motion.
  ; Ordered passes also avoid introducing random ask order.
  foreach sort pedestrians [p -> ask p [update-desired-direction]]
  foreach sort pedestrians [p -> ask p [calculate-acceleration]]
  foreach sort pedestrians [p -> ask p [propose-next-state]]
  resolve-pedestrian-contacts
  foreach sort pedestrians [p -> ask p [finalize-next-state]]
  ; Capture departures too: commit-next-state may remove them immediately.
  set last-step-paths map [p -> [(list who previous-x previous-y step-end-x step-end-y)] of p] sort pedestrians
  foreach sort pedestrians [p -> ask p [commit-next-state]]
  set elapsed-seconds elapsed-seconds + dt
  tick                        ; one tick = one integration step
end

to initialize-pedestrian [initial-x initial-y target-x target-y assigned-direction]
  set shape "circle"
  set size 2 * body-radius     ; radius is used for wall contact, not pair forces
  setxy initial-x initial-y
  set goal-x target-x
  set goal-y target-y
  set travel-direction assigned-direction
  set desired-speed sample-desired-speed
  set color ifelse-value (travel-direction = 1) [orange + 1] [blue]
  set reached-goal? false
  set returned? false
  set waypoints []
  set stop-x false
  set birth-seconds elapsed-seconds
  set started? false
  set slow-seconds 0
  set previous-x xcor
  set previous-y ycor
  set step-end-x xcor
  set step-end-y ycor
  set pen-size 1
  pen-up
  ; Sample once at creation, then retain the same force direction across wraps.
  let noise-angle random-float 360
  set noise-unit-x cos noise-angle
  set noise-unit-y sin noise-angle
  update-desired-direction
  set heading atan ex ey
  ; Actual and preferred velocities initially equal zero.
end

to-report sample-desired-speed
  if mean-desired-speed <= 0 or desired-speed-sd < 0
    [error "Mean desired speed must be positive and its standard deviation nonnegative."]
  ; A Gaussian has an unphysical negative tail; resample nonpositive draws.
  ; At the defaults (1.34 +/- 0.26 m/s), rejection is extremely rare.
  let sampled-speed random-normal mean-desired-speed desired-speed-sd
  while [sampled-speed <= 0] [
    set sampled-speed random-normal mean-desired-speed desired-speed-sd
  ]
  report sampled-speed
end

; Equation (1).
to update-desired-direction
  if active-periodic? [
    ; There is no terminal point on a periodic walkway: keep walking along it.
    set ex travel-direction
    set ey 0
    set drive-factor 1
    stop
  ]
  ; Head for the next waypoint (e.g. a door opening), then the goal.
  while [not empty? waypoints and
         vector-length (item 0 first waypoints - xcor)
                       (item 1 first waypoints - ycor) < waypoint-radius]
    [set waypoints but-first waypoints]
  let target-x goal-x
  let target-y goal-y
  if not empty? waypoints [
    set target-x item 0 first waypoints
    set target-y item 1 first waypoints
  ]
  let delta-x target-x - xcor
  let delta-y target-y - ycor
  let distance-to-goal vector-length delta-x delta-y
  ifelse distance-to-goal > epsilon [
    set ex delta-x / distance-to-goal
    set ey delta-y / distance-to-goal
  ] [
    set ex 0
    set ey 0
  ]
  ; Near stop-x the desired speed becomes gap / (4 tau). For one-dimensional,
  ; uncapped, unforced motion this gives a critically damped gap equation.
  ; Critical damping alone does not prevent overshoot for every initial
  ; approach velocity. The separate stop-line boundary below enforces the
  ; red-light constraint; this factor supplies smooth approach braking.
  ; e stays a unit vector, so the field-of-view weighting of Eq. (5) is unchanged.
  set drive-factor 1
  if is-number? stop-x and ex != 0 [
    let gap (stop-x - xcor) * (ifelse-value (ex > 0) [1] [-1])
    set drive-factor max (list -1 (min (list 1 (gap / (4 * tau * desired-speed)))))
  ]
end

; Equations (2), (4), (5), (6).
to calculate-acceleration
  ; drive-factor is exactly 1 unless a stop line is active (x * 1 = x exactly).
  set ax (desired-speed * drive-factor * ex - vx) / tau
  set ay (desired-speed * drive-factor * ey - vy) / tau

  foreach sort other pedestrians [other-person ->
    let force pair-force other-person
    let fx item 0 force
    let fy item 1 force
    let magnitude vector-length fx fy
    let weight rear-weight
    ; Equation (5) uses MINUS the force in its dot product.
    if ex * (- fx) + ey * (- fy) >= magnitude * cos view-half-angle
      [set weight 1]
    set ax ax + weight * fx
    set ay ay + weight * fy
  ]

  foreach wall-segments [wall ->
    let force wall-force wall
    set ax ax + item 0 force
    set ay ay + item 1 force
  ]
  ; Equation (6): constant random force while noise-strength is held fixed.
  ; Strength is acceleration (m/s^2), not a displacement applied each tick.
  set ax ax + noise-strength * noise-unit-x
  set ay ay + noise-strength * noise-unit-y
end

; Elliptical negative gradient, with a selectable prediction displacement.
to-report pair-force [other-person]
  let qx xcor - [xcor] of other-person
  if active-periodic? [set qx periodic-delta-x qx]
  let qy ycor - [ycor] of other-person
  let sx 0
  let sy 0
  ifelse active-relative-anticipation? [
    ; Relative-velocity anticipation (elliptical specification II, Eq. 12,
    ; Johansson, Helbing & Shukla). Both velocities are actual time-t vectors.
    ; q = x_i - x_j, so the predicted relative displacement is q - T(v_j-v_i).
    set sx anticipation-time * ([vx] of other-person - vx)
    set sy anticipation-time * ([vy] of other-person - vy)
  ] [
    ; Original 1995/report formulation: speed magnitude times desired direction.
    let other-speed vector-length ([vx] of other-person) ([vy] of other-person)
    set sx other-speed * anticipation-time * [ex] of other-person
    set sy other-speed * anticipation-time * [ey] of other-person
  ]
  report elliptical-force qx qy sx sy
end

to-report elliptical-force [qx qy sx sy]
  let rx qx - sx
  let ry qy - sy
  ; Softened lengths prevent division by zero at the ellipse's foci.
  ; Away from singularities the change is negligible (epsilon = 1e-6 m).
  let r1 sqrt (qx * qx + qy * qy + epsilon * epsilon)
  let r2 sqrt (rx * rx + ry * ry + epsilon * epsilon)
  let total-distance r1 + r2
  let b 0.5 * sqrt (max (list (4 * epsilon * epsilon)
    (total-distance * total-distance - sx * sx - sy * sy)))
  let scale (potential-strength / sigma) * exp (- b / sigma)
    * total-distance / (4 * b)
  report (list (scale * (qx / r1 + rx / r2))
               (scale * (qy / r1 + ry / r2)))
end

; Equation (4), for the nearest point on a finite wall segment.
to-report wall-force [wall]
  let nearest nearest-point-on-segment xcor ycor wall
  let delta-x xcor - item 0 nearest
  let delta-y ycor - item 1 nearest
  let d vector-length delta-x delta-y
  ; The outward direction is undefined exactly on a zero-thickness wall.
  if d < epsilon [error "Pedestrian is exactly on a wall. Check its position or reduce dt."]
  let strength wall-strength * exp (- d / wall-range)
  report (list (strength * delta-x / d) (strength * delta-y / d))
end

; Equations (7), (8), (9). Write buffers, not the current state.
to calculate-next-state
  ; Single-pedestrian API used by the mathematical/boundary unit tests.
  ; Production steps use the joint contact pass between these two procedures.
  propose-next-state
  finalize-next-state
end

to propose-next-state
  ; Also capture these when a diagnostic calls this procedure directly.
  set previous-x xcor
  set previous-y ycor
  set next-wrap-count 0
  set next-wx wx + dt * ax
  set next-wy wy + dt * ay
  set-next-velocity-from-preferred
  set next-x xcor + dt * next-vx
  set next-y ycor + dt * next-vy
  apply-wall-contact
  set step-end-x next-x
  set step-end-y next-y
end

; Runs once per pedestrian, after all contact-corrected endpoints are known.
; Exit hooks can record arrivals, so they must never see a rejected proposal.
to finalize-next-state
  if active-periodic? [
    set next-wrap-count abs (floor (next-x / hall-length))
    set next-x next-x mod hall-length
    set reached-goal? false
    set returned? false
    stop
  ]

  ; Arrive if this step's path enters the goal disk, even if it overshoots.
  let path (list xcor ycor next-x next-y)
  let closest nearest-point-on-segment goal-x goal-y path
  set reached-goal? (vector-length (goal-x - item 0 closest)
                                    (goal-y - item 1 closest)) <= arrival-radius
  set returned? false
  ; Scenario-specific exits (e.g. crossing an exit plane), defined by the model.
  scenario-exit-check
end

to set-next-velocity-from-preferred
  ; The paper's actual velocity must always be the capped preferred velocity.
  let preferred-speed vector-length next-wx next-wy
  let speed-factor 1
  if preferred-speed > 0 [
    set speed-factor min (list 1 (1.3 * desired-speed / preferred-speed))
  ]
  set next-vx next-wx * speed-factor
  set next-vy next-wy * speed-factor
end

; Hard boundaries supplement the soft social forces. Wall segments are capsules
; with radius body-radius. Detect the first swept contact, including end posts,
; then resolve all active supporting planes together. Rechecking the whole path
; prevents a later corner correction from violating an earlier wall.
; A single horizontal face keeps the original hallway's normal clamp and
; full-step tangential update, including reapplying the unchanged speed cap.
to apply-wall-contact
  let raw-wx next-wx
  let raw-wy next-wy
  let raw-vx next-vx
  let raw-vy next-vy
  let raw-x next-x
  let raw-y next-y
  let planes []
  ; A red stop line is an explicit scenario boundary, not an extra social force.
  if is-number? stop-x [
    let normal-x (- travel-direction)
    if normal-x * next-x < normal-x * stop-x - 1e-10
      [set planes (list (list normal-x 0 (normal-x * stop-x)))]
  ]
  let finished? false
  let attempts 0
  while [not finished?] [
    if not empty? planes [
      let velocity-planes map [plane -> (list (item 0 plane) (item 1 plane) 0)] planes
      let projected project-to-planes raw-wx raw-wy velocity-planes
      set next-wx item 0 projected
      set next-wy item 1 projected
      set-next-velocity-from-preferred
      ; Keep the attempted normal displacement until it is clamped to contact;
      ; use the newly capped tangential velocity for the whole step, as before.
      let tangent-x next-vx - raw-vx
      let tangent-y next-vy - raw-vy
      let first-plane first planes
      let nx item 0 first-plane
      let ny item 1 first-plane
      let normal-change tangent-x * nx + tangent-y * ny
      set tangent-x tangent-x - normal-change * nx
      set tangent-y tangent-y - normal-change * ny
      if not empty? filter [plane -> abs (nx * item 1 plane - ny * item 0 plane) > 1e-10] planes [
        set tangent-x 0
        set tangent-y 0
      ]
      let projected-position project-to-planes (raw-x + dt * tangent-x) (raw-y + dt * tangent-y) planes
      set next-x item 0 projected-position
      set next-y item 1 projected-position
    ]
    let contact false
    foreach wall-segments [wall ->
      let candidate swept-wall-contact xcor ycor next-x next-y wall
      if candidate != false [
        ifelse contact = false
          [set contact candidate]
          [if item 0 candidate < item 0 contact [set contact candidate]]
      ]
    ]
    ifelse contact = false
      [set finished? true]
      [
        set planes lput (but-first contact) planes
        set attempts attempts + 1
        ; Each support plane excludes a whole convex wall capsule. If numerical
        ; degeneracy prevents progress, fail visibly instead of crossing a wall.
        if attempts > 4 * length wall-segments + 16
          [error "Could not resolve wall constraints. Review geometry and initial clearance."]
      ]
  ]
end

; Euclidean projection onto an intersection of half-planes nx*x + ny*y >= c.
; In 2D the closest feasible point is the input, a line projection, or the
; intersection of two boundary lines. This avoids order-dependent corrections.
to-report project-to-planes [px py planes]
  if inside-planes? px py planes [report (list px py)]
  let best false
  let best-distance 1e100
  foreach planes [plane ->
    let nx item 0 plane
    let ny item 1 plane
    let shift item 2 plane - nx * px - ny * py
    let cx px + shift * nx
    let cy py + shift * ny
    if inside-planes? cx cy planes [
      let distance-squared (cx - px) ^ 2 + (cy - py) ^ 2
      if distance-squared < best-distance [
        set best (list cx cy)
        set best-distance distance-squared
      ]
    ]
  ]
  foreach range length planes [i ->
    foreach (range (i + 1) (length planes)) [j ->
      let a item i planes
      let b item j planes
      let determinant (item 0 a * item 1 b) - (item 1 a * item 0 b)
      if abs determinant > 1e-12 [
        let cx ((item 2 a * item 1 b) - (item 1 a * item 2 b)) / determinant
        let cy ((item 0 a * item 2 b) - (item 2 a * item 0 b)) / determinant
        if inside-planes? cx cy planes [
          let distance-squared (cx - px) ^ 2 + (cy - py) ^ 2
          if distance-squared < best-distance [
            set best (list cx cy)
            set best-distance distance-squared
          ]
        ]
      ]
    ]
  ]
  if best = false [error "Incompatible wall or stop-line constraints. Review initial placement and geometry."]
  report best
end

to-report inside-planes? [px py planes]
  report empty? filter [plane -> item 0 plane * px + item 1 plane * py < item 2 plane - 1e-10] planes
end

; Return [time-fraction nx ny c] for the first entry into a wall's body-radius
; capsule, or false. Periodic full-width horizontal walls have no end posts.
to-report swept-wall-contact [from-x from-y to-x to-y wall]
  let x1 item 0 wall
  let y1 item 1 wall
  let x2 item 2 wall
  let y2 item 3 wall
  if active-periodic? and y1 = y2 and abs (x2 - x1) >= hall-length - epsilon [
    let side ifelse-value (from-y >= y1) [1] [-1]
    let limit side * y1 + body-radius
    if side * to-y >= limit - 1e-10 [report false]
    let fraction 0
    if side * from-y > limit [set fraction (limit - side * from-y) / (side * (to-y - from-y))]
    report (list fraction 0 side limit)
  ]
  if not active-periodic? [report swept-capsule-contact from-x from-y to-x to-y wall]
  let best false
  let first-image (floor (min (list from-x to-x) / hall-length)) - 1
  let last-image (floor (max (list from-x to-x) / hall-length)) + 1
  foreach (range first-image (last-image + 1)) [k ->
    let shift k * hall-length
    let shifted-wall (list (x1 + shift) y1 (x2 + shift) y2)
    let candidate swept-capsule-contact from-x from-y to-x to-y shifted-wall
    if candidate != false [
      ifelse best = false [set best candidate]
        [if item 0 candidate < item 0 best [set best candidate]]
    ]
  ]
  report best
end

to-report swept-capsule-contact [from-x from-y to-x to-y wall]
  let x1 item 0 wall
  let y1 item 1 wall
  let x2 item 2 wall
  let y2 item 3 wall
  let move-x to-x - from-x
  let move-y to-y - from-y
  let seg-x x2 - x1
  let seg-y y2 - y1
  let length-squared seg-x * seg-x + seg-y * seg-y
  let nearest nearest-point-on-segment from-x from-y wall
  let start-nx from-x - item 0 nearest
  let start-ny from-y - item 1 nearest
  let start-distance vector-length start-nx start-ny
  if start-distance < body-radius - 1e-10 [
    if start-distance < epsilon [error "Pedestrian starts on a wall. Review initial placement."]
    set start-nx start-nx / start-distance
    set start-ny start-ny / start-distance
    report (list 0 start-nx start-ny (start-nx * item 0 nearest + start-ny * item 1 nearest + body-radius))
  ]
  let best false
  if length-squared > 0 [
    let seg-length sqrt length-squared
    let nx (- seg-y) / seg-length
    let ny seg-x / seg-length
    foreach [-1 1] [side ->
      let normal-x side * nx
      let normal-y side * ny
      let limit normal-x * x1 + normal-y * y1 + body-radius
      let before normal-x * from-x + normal-y * from-y
      let change normal-x * move-x + normal-y * move-y
      if before >= limit - 1e-10 and change < -1e-12 [
        let fraction (limit - before) / change
        if fraction >= -1e-10 and fraction < 1 - 1e-10 [
          set fraction max (list 0 fraction)
          let hit-x from-x + fraction * move-x
          let hit-y from-y + fraction * move-y
          let along ((hit-x - x1) * seg-x + (hit-y - y1) * seg-y) / length-squared
          if along >= 0 and along <= 1 [
            let candidate (list fraction normal-x normal-y limit)
            ifelse best = false [set best candidate]
              [if fraction < item 0 best [set best candidate]]
          ]
        ]
      ]
    ]
  ]
  foreach (list (list x1 y1) (list x2 y2)) [point ->
    let candidate swept-circle-contact from-x from-y to-x to-y item 0 point item 1 point
    if candidate != false [
      ifelse best = false [set best candidate]
        [if item 0 candidate < item 0 best [set best candidate]]
    ]
  ]
  report best
end

to-report swept-circle-contact [from-x from-y to-x to-y px py]
  let move-x to-x - from-x
  let move-y to-y - from-y
  let quadratic move-x * move-x + move-y * move-y
  if quadratic = 0 [report false]
  let qx from-x - px
  let qy from-y - py
  let half-linear qx * move-x + qy * move-y
  let constant qx * qx + qy * qy - body-radius * body-radius
  let discriminant half-linear * half-linear - quadratic * constant
  if discriminant <= 0 [report false]
  let fraction (- half-linear - sqrt discriminant) / quadratic
  if fraction < -1e-10 or fraction >= 1 - 1e-10 [report false]
  set fraction max (list 0 fraction)
  let nx qx + fraction * move-x
  let ny qy + fraction * move-y
  let norm vector-length nx ny
  if norm = 0 [report false]
  set nx nx / norm
  set ny ny / norm
  if nx * move-x + ny * move-y >= -1e-12 [report false]
  report (list fraction nx ny (nx * px + ny * py + body-radius))
end

to commit-next-state
  if reached-goal? [
    set arrived-count arrived-count + 1
    ; Arrival happens during this step, so it completes at elapsed-seconds + dt.
    set travel-times lput (elapsed-seconds + dt - birth-seconds) travel-times
    set arrival-slow-seconds lput slow-seconds arrival-slow-seconds
    die
  ]
  if returned? [
    set returned-count returned-count + 1
    die
  ]
  set wx next-wx
  set wy next-wy
  set vx next-vx
  set vy next-vy
  ; Stopping statistics (bookkeeping only; does not affect motion).
  let speed vector-length vx vy
  ifelse speed >= 0.5 * desired-speed
    [set started? true]
    [if started? and speed < stop-speed [set slow-seconds slow-seconds + dt]]
  set wrap-count wrap-count + next-wrap-count
  ; Do not draw a false line across the entire view when crossing the seam.
  ifelse show-trails? and next-wrap-count = 0 [pen-down] [pen-up]
  setxy next-x next-y
  if vector-length vx vy > epsilon [set heading atan vx vy]
end

to-report periodic-delta-x [delta-x]
  ; Minimum-image displacement, using the same period as position wrapping.
  report ((delta-x + hall-length / 2) mod hall-length) - hall-length / 2
end

to-report separation-from [px py]
  let delta-x xcor - px
  if active-periodic? [set delta-x periodic-delta-x delta-x]
  report vector-length delta-x (ycor - py)
end

to-report vector-length [delta-x delta-y]
  report sqrt (delta-x * delta-x + delta-y * delta-y)
end

to-report nearest-point-on-segment [px py segment]
  let x1 item 0 segment
  let y1 item 1 segment
  let delta-x (item 2 segment) - x1
  let delta-y (item 3 segment) - y1
  let length-squared delta-x * delta-x + delta-y * delta-y
  if length-squared = 0 [report (list x1 y1)]
  let fraction ((px - x1) * delta-x + (py - y1) * delta-y) / length-squared
  set fraction max (list 0 (min (list 1 fraction)))
  report (list (x1 + fraction * delta-x) (y1 + fraction * delta-y))
end

to-report average-speed
  if not any? pedestrians [report 0]
  report mean map [p -> [vector-length vx vy] of p] sort pedestrians
end

to-report average-desired-speed
  if not any? pedestrians [report 0]
  report mean map [p -> [desired-speed] of p] sort pedestrians
end

to-report desired-speed-spread
  if count pedestrians < 2 [report 0]
  report standard-deviation map [p -> [desired-speed] of p] sort pedestrians
end

; ---------------------------------------------------------------- scenario helpers

; Try up to attempts candidate positions from candidate (an anonymous reporter
; giving [x y]); report the first one that keeps entrance-clearance, or false.
to-report try-place [candidate attempts]
  repeat attempts [
    let spot runresult candidate
    if ped-clear-at? item 0 spot item 1 spot [report spot]
  ]
  report false
end

to-report random-between [low high]
  report low + random-float (high - low)
end

; Standard exit rule for a walkway along x, usable as scenario-exit-check:
; arrive on crossing the far exit plane (open-right when walking right,
; open-left when walking left); pushed back through the entrance = returned.
to x-walkway-exit-check
  if (travel-direction = 1 and next-x >= open-right) or
     (travel-direction = -1 and next-x <= open-left)
    [set reached-goal? true]
  set returned? ((travel-direction = 1 and next-x < open-left) or
                 (travel-direction = -1 and next-x > open-right))
end

; Draw every wall segment into the drawing layer (patches are 1 m, too
; coarse for door posts). Trails share this layer; setup's clear-all clears it.
to draw-walls [wall-color]
  create-turtles 1 [
    set color wall-color
    set pen-size 3
    foreach wall-segments [wall ->
      pen-up
      setxy item 0 wall item 1 wall
      pen-down
      setxy item 2 wall item 3 wall
    ]
    die
  ]
end
