; =============================================================================
; core/stats.nls -- statistics, plotting and CSV logging
; =============================================================================
; Statistics, plotting and CSV logging shared by all scenarios.
; Requires core/pedestrians.nls.
;
; Variance and standard deviation are SAMPLE statistics (divide by n - 1),
; matching NetLogo's built-in variance / standard-deviation. Use
; stat-population-variance if the population version (divide by n) is wanted.
;
; Plot widgets cannot be shared between models, but their update code can:
; give a plot three pens named "mean", "+sd" and "-sd" and use e.g.
;   plot-mean-sd speeds
; as the plot's update command.
;
; Nothing here uses random numbers or changes pedestrians, so plotting and
; logging never alter a simulation run.

globals [
  log-file                 ; current CSV file name, or "" when not logging
  stats-interval           ; simulated seconds between plot/log samples
  last-logged-seconds      ; prevents duplicate rows from repeated calls in one step
]

; Defaults; call in setup. Samples every 0.1 simulated seconds, no log open.
to stats-reset
  set log-file ""
  set stats-interval 0.1
  set last-logged-seconds -1
end

; Sample the first completed step at/after each interval boundary. The row uses
; its actual elapsed time; no interpolation is implied. For dt=.03 and an
; interval of .1 this gives .12, .21, .30, ... instead of drifting by .09.
; This reporter is idempotent so plot and CSV callers see the same decision.
;
; The last step covered [start, start + duration]. It is a sample step when
; that interval contains a multiple of stats-interval, i.e. when the interval
; index floor(t / stats-interval) increased during the step. The tiny slack
; stops floating-point round-off (e.g. 0.30000000000000004) from moving a
; boundary into the wrong step.
to-report stats-sample?
  if stats-interval <= 0 [error "stats-interval must be positive."]
  if elapsed-seconds = 0 [report true]       ; always sample the initial state
  if last-step-duration <= 0 [report false]
  let time-slack 1e-10 * stats-interval
  report floor ((last-step-start-seconds + last-step-duration + time-slack) / stats-interval) >
         floor ((last-step-start-seconds + time-slack) / stats-interval)
end

; ---------------------------------------------------------------- numbers
; Safe wrappers around NetLogo's built-ins: they report 0 instead of raising
; an error for lists that are too short.

to-report stat-mean [xs]
  if empty? xs [report 0]
  report mean xs
end

; Sample variance (divide by n - 1); 0 for fewer than two values.
to-report stat-variance [xs]
  if length xs < 2 [report 0]
  report variance xs
end

; Sample standard deviation; 0 for fewer than two values.
to-report stat-sd [xs]
  if length xs < 2 [report 0]
  report standard-deviation xs
end

; Population variance (divide by n); 0 for an empty list.
to-report stat-population-variance [xs]
  if empty? xs [report 0]
  let m mean xs
  report (sum map [x -> (x - m) ^ 2] xs) / length xs
end

; [mean sd variance n]
to-report stat-summary [xs]
  report (list stat-mean xs stat-sd xs stat-variance xs length xs)
end

; ---------------------------------------------------------------- quantities
; Each reporter lists one value per pedestrian, in who order.

; Current speed |v| of every pedestrian (m/s).
to-report speeds
  report map [p -> [vector-length vx vy] of p] sort pedestrians
end

; Speed relative to each pedestrian's own desired speed (1 = walking at v0).
to-report speed-ratios
  report map [p -> [vector-length vx vy / desired-speed] of p] sort pedestrians
end

; Velocity component along the desired direction e (m/s): progress made.
to-report forward-speeds
  report map [p -> [vx * ex + vy * ey] of p] sort pedestrians
end

; Sideways speed relative to e (m/s).
; |v x e| (2D cross product) is the velocity component perpendicular to e.
to-report lateral-speeds
  report map [p -> [abs (vy * ex - vx * ey)] of p] sort pedestrians
end

; Fraction of walking pedestrians currently slower than stop-speed.
to-report stopped-fraction
  if not any? pedestrians [report 0]
  let people sort pedestrians
  report (length filter [p -> [vector-length vx vy < stop-speed] of p] people) / length people
end

; Fraction of arrived pedestrians that were ever stopped after starting.
to-report arrivals-ever-stopped-fraction
  if empty? arrival-slow-seconds [report 0]
  report length filter [s -> s > 0] arrival-slow-seconds / length arrival-slow-seconds
end

; ---------------------------------------------------------------- plotting

; Plot mean and mean +/- one SD of xs against simulated time on the current plot.
; Only plots on sampling steps, so the plot has one point per stats-interval.
to plot-mean-sd [xs]
  if empty? xs or not stats-sample? [stop]
  let m stat-mean xs
  let s stat-sd xs
  set-current-plot-pen "mean"
  plotxy elapsed-seconds m
  set-current-plot-pen "+sd"
  plotxy elapsed-seconds m + s
  set-current-plot-pen "-sd"
  plotxy elapsed-seconds m - s
end

; ---------------------------------------------------------------- CSV log

; Start a CSV file (overwritten), sampled on steps crossing interval boundaries.
; Writes the header row; each later row is written by log-row.
to log-start [file-name]
  log-stop
  if file-exists? file-name [file-delete file-name]
  set log-file file-name
  set last-logged-seconds -1
  file-open log-file
  ; Columns: time, population counts, then mean/sd/var of each quantity.
  file-print (word "time_s,walking,arrived,"
    "speed_mean,speed_sd,speed_var,"
    "speed_ratio_mean,speed_ratio_sd,speed_ratio_var,"
    "forward_mean,forward_sd,forward_var,"
    "lateral_mean,lateral_sd,lateral_var,"
    "stopped_fraction,travel_time_mean,travel_time_sd,travel_time_var")
  file-close
end

; Append one row if a log is open and this is a sampling step.
; The file is opened and closed per row, so the CSV is always complete on
; disk even if the run is interrupted.
to log-row
  if log-file = "" or not stats-sample? or elapsed-seconds = last-logged-seconds [stop]
  file-open log-file
  ; but-last drops n from each [mean sd variance n] summary.
  file-print csv-row (sentence elapsed-seconds count pedestrians arrived-count
    but-last stat-summary speeds
    but-last stat-summary speed-ratios
    but-last stat-summary forward-speeds
    but-last stat-summary lateral-speeds
    stopped-fraction
    but-last stat-summary travel-times)
  file-close
  set last-logged-seconds elapsed-seconds
end

; Stop logging. Safe to call when no log is open.
to log-stop
  if is-string? log-file and log-file != "" [carefully [file-close] []]
  set log-file ""
end

; Join a list of values with commas: [1 2 3] -> "1,2,3".
to-report csv-row [values]
  report reduce [[a b] -> (word a "," b)] values
end
