<?xml version="1.0" encoding="utf-8"?>
<model version="NetLogo 7.0.4" snapToGrid="true">
  <code><![CDATA[; =============================================================================
; scenarios/Crossing.nlogox -- crossing scenario
; =============================================================================
; Crossing scenario: two corridors cross at right angles. Pedestrians walk
; horizontally and vertically through the shared square. The crossing is not
; an object: it emerges from where the walls and the flows are placed.
; Shared model: ../core/pedestrians.nls.
; Interface variables: dt, mean-desired-speed, desired-speed-sd,
; simulation-seed, show-trails?,
; run-checks?, log-csv?, corridor-width, horizontal-rate, vertical-rate,
; two-way?, crossing-yielding?.
;
; Geometry (metres): a 30 x 30 m world. A horizontal and a vertical corridor,
; each corridor-width wide, cross in a square centred at (15, 15). Exit
; planes at 1 and 29 on both axes.
;
; Measured per arrival: travel time, free-walking time (straight-line
; distance / desired speed) and time spent standing, so the delay caused by
; the crossing can be compared between the two flows.

__includes [ "../core/pedestrians.nls" "../core/avm.nls" "../core/boundaries.nls" "../core/checks.nls" "../core/stats.nls" ]

globals [
  center half-width       ; middle of the crossing; half the corridor width
  open-bottom open-top    ; exit planes of the vertical corridor
  horizontal-results      ; [travel-time free-time slow-seconds] per arrival
  vertical-results
  active-crossing-yielding? crossing-green-vertical? crossing-draining?
  crossing-phase-start-seconds crossing-admissions crossing-phase-count
  crossing-batch-size crossing-phase-duration crossing-switch-log
]

turtles-own [
  vertical?               ; walking up/down instead of left/right
  free-time               ; straight-line distance / desired speed at creation
  crossing-admitted? crossing-cleared?
]

; Build the plus-shaped walkable area; no pedestrians exist at the start.
to setup
  clear-all
  ped-init-constants
  checks-reset
  stats-reset
  if corridor-width < 1 or corridor-width > 20 [error "corridor-width must be between 1 and 20 m."]
  set hall-length 30
  set center 15
  set half-width corridor-width / 2
  set open-left 1
  set open-right hall-length - 1
  set open-bottom 1
  set open-top hall-length - 1
  resize-world 0 hall-length 0 hall-length
  set-topology false false
  ; Four L-shaped corners bound a plus-shaped walkable area.
  ; lo and hi are the corridor edges on both axes.
  let lo center - half-width
  let hi center + half-width
  set wall-segments (list
    (list 0 lo lo lo) (list lo 0 lo lo)                         ; bottom-left
    (list hi lo hall-length lo) (list hi 0 hi lo)               ; bottom-right
    (list 0 hi lo hi) (list lo hi lo hall-length)               ; top-left
    (list hi hi hall-length hi) (list hi hi hi hall-length))    ; top-right
  ; White inside either corridor, dark grey in the four corner blocks.
  ask patches [
    set pcolor ifelse-value ((pycor > lo and pycor < hi) or (pxcor > lo and pxcor < hi))
      [white] [gray - 2]
  ]
  draw-walls black
  set horizontal-results []
  set vertical-results []
  set active-crossing-yielding? crossing-yielding?
  set crossing-green-vertical? false
  set crossing-draining? false
  set crossing-phase-start-seconds 0
  set crossing-admissions 0
  set crossing-phase-count 0
  ; Finite admission phases retain capacity at 1.8 attempts/s in each stream.
  ; These are explicit scenario coordination parameters, not AVM parameters.
  set crossing-batch-size 64
  set crossing-phase-duration 20
  set crossing-switch-log []
  random-seed simulation-seed
  if log-csv? [log-start "../work/crossing.csv"]
  reset-ticks
end

; One integration step: arrivals in both corridors, detours for displaced
; walkers, motion, checks and logging.
to go
  checks-begin-step
  ped-check-parameters
  if horizontal-rate < 0 or vertical-rate < 0 [error "Arrival rates must not be negative."]
  ; Independent Poisson arrivals for each corridor (rates per second).
  repeat random-poisson (horizontal-rate * dt) [spawn-walker false]
  repeat random-poisson (vertical-rate * dt) [spawn-walker true]
  crossing-update-membership
  crossing-update-controller
  foreach sort pedestrians [p -> ask p [
    reroute-if-displaced
    crossing-apply-gate
  ]]
  ped-step
  crossing-update-membership
  if run-checks? [checks-update]
  log-row
end

; Hook required by core/pedestrians.nls.
; Vertical walkers leave through the top/bottom exit planes, horizontal ones
; through the left/right planes. Arrivals are recorded per corridor.
to scenario-exit-check
  ifelse vertical? [
    if (travel-direction = 1 and next-y >= open-top) or
       (travel-direction = -1 and next-y <= open-bottom)
      [set reached-goal? true]
    set returned? ((travel-direction = 1 and next-y < open-bottom) or
                   (travel-direction = -1 and next-y > open-top))
  ] [
    x-walkway-exit-check
  ]
  if reached-goal? [
    ; The arrival completes at the end of this step (elapsed-seconds + dt).
    let result (list (elapsed-seconds + dt - birth-seconds) free-time slow-seconds)
    ifelse vertical?
      [set vertical-results lput result vertical-results]
      [set horizontal-results lput result horizontal-results]
  ]
end

; travel-direction is +1 for right/up and -1 for left/down.
; Create one walker at the entrance of the horizontal or vertical corridor.
; One-way: always right/up. Two-way: either direction with equal chance.
to spawn-walker [is-vertical?]
  let direction ifelse-value (two-way? and random 2 = 0) [-1] [1]
  ; start/finish are coordinates along the walking axis (x or y).
  let start ifelse-value (direction = 1) [open-left] [open-right]
  let finish ifelse-value (direction = 1) [open-right] [open-left]
  let spot try-place [-> ifelse-value is-vertical?
      [(list random-across start)] [(list start random-across)]] 20
  if spot = false [
    set blocked-spawn-count blocked-spawn-count + 1
    stop
  ]
  ; Goal: a new random position across the corridor at the far exit.
  let across random-across
  let goal ifelse-value is-vertical? [(list across finish)] [(list finish across)]
  create-pedestrians 1 [
    initialize-pedestrian item 0 spot item 1 spot item 0 goal item 1 goal direction
    set vertical? is-vertical?
    set crossing-admitted? false
    set crossing-cleared? false
    ; Vertical walkers: green going up, violet going down.
    if vertical? [set color ifelse-value (direction = 1) [green - 1] [violet]]
    set free-time vector-length (goal-x - xcor) (goal-y - ycor) / desired-speed
  ]
  set spawned-count spawned-count + 1
end

; Explicit yielding coordination, outside the AVM equations. The two streams
; alternate finite admission phases. Closing a phase holds only walkers that
; have not crossed its gate; everyone already admitted may finish crossing.
; The opposite stream opens only after all admitted bodies have left the
; shared region. No pairwise projection, minimum-gap rule or forced motion is
; used. The usual scalar stop-plane rule is applied before position updates.
to crossing-update-controller
  if not active-crossing-yielding? [stop]
  if not crossing-draining? and
     (crossing-admissions >= crossing-batch-size or
      elapsed-seconds - crossing-phase-start-seconds >= crossing-phase-duration) [
    set crossing-draining? true
  ]
  if crossing-draining? and crossing-unfinished-count = 0 [
    set crossing-green-vertical? not crossing-green-vertical?
    set crossing-draining? false
    set crossing-phase-start-seconds elapsed-seconds
    set crossing-switch-log lput
      (list elapsed-seconds crossing-green-vertical? crossing-admissions crossing-unfinished-count)
      crossing-switch-log
    set crossing-admissions 0
    set crossing-phase-count crossing-phase-count + 1
  ]
end

to crossing-update-membership
  if not active-crossing-yielding? [stop]
  foreach sort pedestrians [p -> ask p [
    let along ifelse-value vertical? [ycor] [xcor]
    let across ifelse-value vertical? [xcor] [ycor]
    if not crossing-admitted? and
       travel-direction * (along - crossing-gate-coordinate) > 1e-8 [
      set crossing-admitted? true
      set crossing-admissions crossing-admissions + 1
    ]
    ; Recompute the physical clearance rather than trusting an old passage.
    set crossing-cleared? crossing-admitted? and
      travel-direction * (along - crossing-clear-coordinate) >= 0 and
      abs (across - center) <= half-width - body-radius + 1e-8
  ]]
end

to crossing-apply-gate
  set stop-x false
  set stop-y false
  if not active-crossing-yielding? or crossing-admitted? [stop]
  if crossing-draining? or vertical? != crossing-green-vertical? [
    ifelse vertical?
      [set stop-y crossing-gate-coordinate]
      [set stop-x crossing-gate-coordinate]
  ]
end

to-report crossing-gate-coordinate
  report center - travel-direction * (half-width + body-radius + avm-wall-buffer + 0.5)
end

to-report crossing-clear-coordinate
  report center + travel-direction * (half-width + body-radius + avm-wall-buffer)
end

to-report crossing-unfinished-count
  report count pedestrians with [crossing-admitted? and not crossing-cleared?]
end

to-report crossing-control-status
  if not active-crossing-yielding? [report "uncontrolled"]
  report word (ifelse-value crossing-green-vertical? ["vertical"] ["horizontal"])
    (ifelse-value crossing-draining? [" clearing"] [" admitting"])
end

; Supply AVM's desired direction in two geometric stages: the nearest point
; of the outgoing corridor portal, then the unchanged random final goal.
; The portal spans the usable corridor width; no lane or stream has priority.
; If a corner blocks the direct route, select the shortest visible path via
; an inset corner of the central square. AVM still selects direction and speed.
to reroute-if-displaced
  set waypoints []
  let clearance body-radius + avm-wall-buffer
  let lo center - half-width + clearance
  let hi center + half-width - clearance
  let target-x goal-x
  let target-y goal-y
  let portal center + travel-direction * (half-width + clearance)
  let along ifelse-value vertical? [ycor] [xcor]
  if travel-direction * along < travel-direction * portal [
    ifelse vertical? [
      set target-y portal
      set target-x max (list lo min (list hi xcor))
    ] [
      set target-x portal
      set target-y max (list lo min (list hi ycor))
    ]
  ]
  ifelse crossing-route-clear? xcor ycor target-x target-y [
    if target-x != goal-x or target-y != goal-y [crossing-aim-at target-x target-y]
  ] [
    let best false
    let shortest 1e100
    foreach (list (list lo lo) (list lo hi) (list hi lo) (list hi hi)) [point ->
      let px item 0 point
      let py item 1 point
      if crossing-route-clear? xcor ycor px py and
         crossing-route-clear? px py target-x target-y [
        let length-now (vector-length (px - xcor) (py - ycor)) +
                       (vector-length (target-x - px) (target-y - py))
        if length-now < shortest [set shortest length-now set best point]
      ]
    ]
    if best != false [crossing-aim-at item 0 best item 1 best]
  ]
end

; Extend a short routing target along the same ray. This retains its unit
; desired direction while preventing the shared .5 m waypoint-arrival radius
; from dropping a corner/portal target before the geometric handoff is clear.
to crossing-aim-at [target-x target-y]
  let dx-target target-x - xcor
  let dy-target target-y - ycor
  let length-now vector-length dx-target dy-target
  if length-now > epsilon [
    let scale max (list 1 ((waypoint-radius + 1e-6) / length-now))
    set waypoints (list (list (xcor + scale * dx-target) (ycor + scale * dy-target)))
  ]
end

; A straight route for the pedestrian's disk, including the round wall ends.
; This is obstacle visibility for navigation, not a pedestrian gap constraint.
to-report crossing-route-clear? [from-x from-y to-x to-y]
  let clear? true
  foreach wall-segments [wall ->
    if avm-swept-wall-contact from-x from-y to-x to-y wall != false [set clear? false]
  ]
  report clear?
end

; A position across a corridor, 0.5 m clear of its walls.
to-report random-across
  report random-between (center - half-width + 0.5) (center + half-width - 0.5)
end

; ---------------------------------------------------------------- results
; group is "horizontal" or "vertical".

; Raw [travel-time free-time slow-seconds] records of one group.
to-report results-of [group]
  report ifelse-value (group = "vertical") [vertical-results] [horizontal-results]
end

; Travel times (s) of the arrived walkers of one group.
to-report travel-times-of [group]
  report map [r -> item 0 r] results-of group
end

; Travel time divided by the free-walking time (1 = never slowed down).
to-report delay-ratios-of [group]
  report map [r -> item 0 r / item 1 r] results-of group
end

; Fraction of arrivals that stood still (below stop-speed) at some point.
to-report stopped-fraction-of [group]
  let results results-of group
  if empty? results [report 0]
  report length filter [r -> item 2 r > 0] results / length results
end

; The walkers of one group currently in the world.
to-report walkers-of [group]
  report pedestrians with [vertical? = (group = "vertical")]
end

; Current speeds of one group (m/s).
to-report speeds-of [group]
  report map [p -> [vector-length vx vy] of p] sort walkers-of group
end

; Pedestrians currently inside the shared square.
to-report in-crossing-count
  report count pedestrians with
    [abs (xcor - center) < half-width and abs (ycor - center) < half-width]
end
]]></code>
  <widgets>
    <view x="265" y="10" width="469" height="469" patchSize="15" minPxcor="0" maxPxcor="30" minPycor="0" maxPycor="30" wrappingAllowedX="false" wrappingAllowedY="false" frameRate="30" fontSize="12" showTickCounter="true" tickCounterLabel="steps" updateMode="1" />
    <button x="10" y="10" width="75" height="40" display="setup" kind="Observer" forever="false" disableUntilTicks="false">setup</button>
    <button x="90" y="10" width="75" height="40" display="go" kind="Observer" forever="true" disableUntilTicks="true">go</button>
    <button x="170" y="10" width="75" height="40" display="step" kind="Observer" forever="false" disableUntilTicks="true">go</button>
    <slider x="10" y="60" width="235" height="50" display="dt" variable="dt" min="0.005" max="0.1" step="0.005" default="0.02" direction="Horizontal" units="s" />
    <slider x="10" y="115" width="235" height="50" display="mean-desired-speed" variable="mean-desired-speed" min="0.2" max="2.0" step="0.01" default="1.55" direction="Horizontal" units="m/s" />
    <slider x="10" y="170" width="235" height="50" display="desired-speed-sd" variable="desired-speed-sd" min="0" max="0.8" step="0.01" default="0.18" direction="Horizontal" units="m/s" />
    <monitor x="10" y="225" width="235" height="50" display="body radius (m)" precision="2" fontSize="11">body-radius</monitor>
