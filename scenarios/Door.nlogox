      <pen display="waiting at door" interval="1.0" mode="0" color="-2674135" legend="true">
        <setup></setup>
        <update>if stats-sample? [plotxy elapsed-seconds waiting-at-door]</update>
      </pen>
      <pen display="passes / 10" interval="1.0" mode="0" color="-13345367" legend="true">
        <setup></setup>
        <update>if stats-sample? [plotxy elapsed-seconds door-passes / 10]</update>
      </pen>
    </plot>
    <monitor x="275" y="795" width="190" height="55" display="integration segments" precision="0" fontSize="11">length last-internal-step-paths</monitor>
    <monitor x="475" y="795" width="190" height="55" display="shortest segment (s)" precision="8" fontSize="11">ifelse-value (empty? last-internal-step-paths) [0] [min map [entry -&gt; item 1 entry] last-internal-step-paths]</monitor>
    <monitor x="275" y="865" width="190" height="55" display="repulsion k" precision="3" fontSize="11">avm-strength</monitor>
    <monitor x="475" y="865" width="190" height="55" display="range D (m)" precision="3" fontSize="11">avm-range</monitor>
    <monitor x="675" y="865" width="190" height="55" display="time gap T (s)" precision="3" fontSize="11">avm-time-gap</monitor>
    <monitor x="875" y="865" width="190" height="55" display="turning tau (s)" precision="3" fontSize="11">tau</monitor>
