<?xml version="1.0" encoding="utf-8"?>
<model version="NetLogo 7.0.4" snapToGrid="true">
  <code><![CDATA[; Door scenario: a corridor divided by a wall with one door opening.
; Pedestrians start on one or both sides and must pass the door to reach the
; far end. Shared model: ../core/pedestrians.nls (forces, integration, walls).
; Interface variables: dt, mean-desired-speed, desired-speed-sd,
; noise-strength, simulation-seed, show-trails?, relative-anticipation?,
; run-checks?, log-csv?, door-width, room-width, initial-per-side,
; spawn-rate, two-sided?.

__includes [ "../core/pedestrians.nls" "../core/contact.nls" "../core/checks.nls" "../core/stats.nls" ]

globals [
  door-x door-center-y    ; door plane and the middle of the opening
  door-sequence           ; one entry per passage in order: +1 rightwards, -1 leftwards
  emptied-seconds         ; time the corridor first became empty, or false
]

turtles-own [ door-side ]  ; -1 left of the door plane, +1 right of it

to setup
  clear-all
  ped-init-constants
  checks-reset
  stats-reset
  if door-width >= room-width [error "door-width must be smaller than room-width."]
  set hall-length 20
  set hall-bottom 1.5
  set hall-top hall-bottom + room-width
  set open-left 1
  set open-right hall-length - 1
  set door-x hall-length / 2
  set door-center-y (hall-bottom + hall-top) / 2
  resize-world 0 hall-length 0 (ceiling (hall-top + 1.5))
  set-topology false false
  ; Two corridor walls and the dividing wall, interrupted by the door.
  set wall-segments (list
    (list 0 hall-bottom hall-length hall-bottom)
    (list 0 hall-top hall-length hall-top)
    (list door-x hall-bottom door-x (door-center-y - door-width / 2))
    (list door-x (door-center-y + door-width / 2) door-x hall-top))
  ask patches [
    set pcolor ifelse-value (pycor < hall-bottom or pycor > hall-top) [gray - 2] [white]
  ]
  draw-walls black
  set door-sequence []
  set emptied-seconds false
  random-seed simulation-seed
  place-initial-crowd 1
  if two-sided? [place-initial-crowd -1]
  if log-csv? [log-start "../work/door.csv"]
  reset-ticks
end

to go
  ped-check-parameters
  if spawn-rate < 0 [error "spawn-rate must not be negative."]
  repeat random-poisson (spawn-rate * dt) [spawn-at-entrance]
  ped-step
  track-door
  if run-checks? [checks-update]
  log-row
  if emptied-seconds = false and spawned-count > 0 and not any? pedestrians
    [set emptied-seconds elapsed-seconds]
end

; Hook required by core/pedestrians.nls.
to scenario-exit-check
  x-walkway-exit-check
end

; initial-per-side pedestrians scattered over the side they start from.
to place-initial-crowd [direction]
  let low ifelse-value (direction = 1) [open-left + 0.5] [door-x + 1]
  let high ifelse-value (direction = 1) [door-x - 1] [open-right - 0.5]
  repeat initial-per-side [
    let spot try-place [-> (list random-between low high random-room-y)] 2000
    if spot = false
      [error "Could not place the initial crowd with clearance. Reduce initial-per-side."]
    add-pedestrian item 0 spot item 1 spot direction
  ]
end

to spawn-at-entrance
  let direction ifelse-value (two-sided? and random 2 = 0) [-1] [1]
  let entrance-x ifelse-value (direction = 1) [open-left] [open-right]
  let spot try-place [-> (list entrance-x random-room-y)] 20
  ifelse spot = false
    [set blocked-spawn-count blocked-spawn-count + 1]
    [add-pedestrian item 0 spot item 1 spot direction]
end

to-report random-room-y
  report random-between (hall-bottom + 0.75) (hall-top - 0.75)
end

; A pedestrian heading for the far end via the middle of the door.
to add-pedestrian [x y direction]
  let target-y random-room-y
  create-pedestrians 1 [
    initialize-pedestrian x y (ifelse-value (direction = 1) [open-right] [open-left])
      target-y direction
    set waypoints (list (list door-x door-center-y))
    set door-side ifelse-value (xcor < door-x) [-1] [1]
    update-desired-direction
    set heading atan ex ey
  ]
  set spawned-count spawned-count + 1
end

; Record every passage through the door plane in within-step time order.
; Snapshots include pedestrians removed at exits during the same step.
to track-door
  let crossings []
  foreach last-step-paths [path ->
    let start-x item 1 path
    let finish-x item 3 path
    let old-side ifelse-value (start-x < door-x) [-1] [1]
    let side ifelse-value (finish-x < door-x) [-1] [1]
    if old-side != side [
      let fraction (door-x - start-x) / (finish-x - start-x)
      set crossings lput (list fraction (item 0 path) side) crossings
    ]
  ]
  set crossings sort-by [[a b] ->
    ifelse-value (item 0 a = item 0 b)
      [item 1 a < item 1 b] [item 0 a < item 0 b]] crossings
  foreach crossings [event -> set door-sequence lput (item 2 event) door-sequence]
  foreach sort pedestrians [p -> ask p [
    let side ifelse-value (xcor < door-x) [-1] [1]
    set door-side side
    ; Not through yet (or pushed back): keep steering for the opening, so
    ; nobody walks straight at the wall beside it.
    if side != travel-direction and empty? waypoints
      [set waypoints (list (list door-x door-center-y))]
  ]]
end

to-report door-passes
  report length door-sequence
end

to-report passes-in-direction [direction]
  report length filter [s -> s = direction] door-sequence
end

; Fraction of consecutive passages that change direction. Strict alternation
; gives 1; one side passing first in a block gives close to 0.
to-report alternation-fraction
  if length door-sequence < 2 [report 0]
  let changes (map [[a b] -> a != b] but-last door-sequence but-first door-sequence)
  report length filter [c -> c] changes / length changes
end

to-report door-flow  ; passages per second
  if elapsed-seconds <= 0 [report 0]
  report door-passes / elapsed-seconds
end

; Pedestrians standing still within 3 m of the door: waiting their turn.
to-report waiting-at-door
  report count pedestrians with
    [abs (xcor - door-x) < 3 and vector-length vx vy < stop-speed]
end
]]></code>
  <widgets>
    <view x="265" y="10" width="634" height="304" patchSize="30" minPxcor="0" maxPxcor="20" minPycor="0" maxPycor="9" wrappingAllowedX="false" wrappingAllowedY="false" frameRate="30" fontSize="12" showTickCounter="true" tickCounterLabel="steps" updateMode="1" />
    <button x="10" y="10" width="75" height="40" display="setup" kind="Observer" forever="false" disableUntilTicks="false">setup</button>
    <button x="90" y="10" width="75" height="40" display="go" kind="Observer" forever="true" disableUntilTicks="true">go</button>
    <button x="170" y="10" width="75" height="40" display="step" kind="Observer" forever="false" disableUntilTicks="true">go</button>
    <slider x="10" y="60" width="235" height="50" display="dt" variable="dt" min="0.005" max="0.1" step="0.005" default="0.02" direction="Horizontal" units="s" />
    <slider x="10" y="115" width="235" height="50" display="mean-desired-speed" variable="mean-desired-speed" min="0.2" max="2.0" step="0.02" default="1.34" direction="Horizontal" units="m/s" />
    <slider x="10" y="170" width="235" height="50" display="desired-speed-sd" variable="desired-speed-sd" min="0" max="0.8" step="0.01" default="0.26" direction="Horizontal" units="m/s" />
    <slider x="10" y="225" width="235" height="50" display="noise-strength" variable="noise-strength" min="0" max="0.2" step="0.005" default="0" direction="Horizontal" units="m/s^2" />
    <slider x="10" y="280" width="235" height="50" display="simulation-seed" variable="simulation-seed" min="0" max="1000" step="1" default="42" direction="Horizontal" units="setup" />
    <switch x="10" y="335" width="235" height="40" on="true" variable="relative-anticipation?" display="relative-anticipation?" />
    <switch x="10" y="380" width="235" height="40" on="true" variable="run-checks?" display="run-checks?" />
    <switch x="10" y="425" width="235" height="40" on="false" variable="show-trails?" display="show-trails?" />
    <switch x="10" y="470" width="235" height="40" on="false" variable="log-csv?" display="log-csv?" />
    <slider x="10" y="520" width="235" height="50" display="door-width" variable="door-width" min="0.6" max="3" step="0.05" default="1.2" direction="Horizontal" units="m" />
    <slider x="10" y="575" width="235" height="50" display="room-width" variable="room-width" min="3" max="12" step="0.5" default="6" direction="Horizontal" units="m" />
    <slider x="10" y="630" width="235" height="50" display="initial-per-side" variable="initial-per-side" min="0" max="60" step="1" default="20" direction="Horizontal" units="people" />
    <slider x="10" y="685" width="235" height="50" display="spawn-rate" variable="spawn-rate" min="0" max="3" step="0.1" default="0" direction="Horizontal" units="attempts/s" />
    <switch x="10" y="740" width="235" height="40" on="true" variable="two-sided?" display="two-sided?" />
    <monitor x="265" y="329" width="150" height="55" display="simulated seconds" precision="2" fontSize="11">elapsed-seconds</monitor>
    <monitor x="425" y="329" width="150" height="55" display="walking" precision="0" fontSize="11">count pedestrians</monitor>
    <monitor x="585" y="329" width="150" height="55" display="arrived" precision="0" fontSize="11">arrived-count</monitor>
    <monitor x="745" y="329" width="150" height="55" display="returned" precision="0" fontSize="11">returned-count</monitor>
    <monitor x="905" y="329" width="150" height="55" display="blocked arrivals" precision="0" fontSize="11">blocked-spawn-count</monitor>
    <monitor x="265" y="389" width="150" height="55" display="mean speed (m/s)" precision="3" fontSize="11">stat-mean speeds</monitor>
    <monitor x="425" y="389" width="150" height="55" display="overlapping pairs" precision="0" fontSize="11">overlap-pair-count</monitor>
    <monitor x="585" y="389" width="150" height="55" display="pass-throughs" precision="0" fontSize="11">pass-through-events</monitor>
    <monitor x="745" y="389" width="150" height="55" display="wall penetrations" precision="0" fontSize="11">wall-penetration-count</monitor>
    <monitor x="905" y="389" width="150" height="55" display="min separation seen" precision="3" fontSize="11">ifelse-value (worst-min-separation &gt; 1e8) ["-"] [worst-min-separation]</monitor>
    <monitor x="265" y="449" width="150" height="55" display="door passes" precision="0" fontSize="11">door-passes</monitor>
    <monitor x="425" y="449" width="150" height="55" display="passes right" precision="0" fontSize="11">passes-in-direction 1</monitor>
    <monitor x="585" y="449" width="150" height="55" display="passes left" precision="0" fontSize="11">passes-in-direction -1</monitor>
    <monitor x="745" y="449" width="150" height="55" display="alternation" precision="3" fontSize="11">alternation-fraction</monitor>
    <monitor x="905" y="449" width="150" height="55" display="waiting at door" precision="0" fontSize="11">waiting-at-door</monitor>
    <monitor x="265" y="509" width="150" height="55" display="emptied at (s)" precision="2" fontSize="11">ifelse-value (emptied-seconds = false) ["-"] [emptied-seconds]</monitor>
    <plot x="265" y="579" width="400" height="200" display="speed (m/s): mean +/- sd" xAxis="simulated seconds" yAxis="m/s" xMin="0.0" xMax="10.0" yMin="0.0" yMax="1.0" autoPlotX="true" autoPlotY="true" legend="true">
      <setup></setup>
      <update>plot-mean-sd speeds</update>
      <pen display="mean" interval="1.0" mode="0" color="-16777216" legend="true">
        <setup></setup>
        <update></update>
      </pen>
      <pen display="+sd" interval="1.0" mode="0" color="-7500403" legend="true">
        <setup></setup>
        <update></update>
      </pen>
      <pen display="-sd" interval="1.0" mode="0" color="-7500403" legend="true">
        <setup></setup>
        <update></update>
      </pen>
    </plot>
    <plot x="675" y="579" width="400" height="200" display="door" xAxis="simulated seconds" yAxis="count" xMin="0.0" xMax="10.0" yMin="0.0" yMax="1.0" autoPlotX="true" autoPlotY="true" legend="true">
      <setup></setup>
      <update></update>
      <pen display="waiting at door" interval="1.0" mode="0" color="-2674135" legend="true">
        <setup></setup>
        <update>if stats-sample? [plotxy elapsed-seconds waiting-at-door]</update>
      </pen>
      <pen display="passes / 10" interval="1.0" mode="0" color="-13345367" legend="true">
        <setup></setup>
        <update>if stats-sample? [plotxy elapsed-seconds door-passes / 10]</update>
      </pen>
    </plot>
  </widgets>
  <info><![CDATA[## WHAT IS IT?

A 20 m corridor (`room-width` wide) is divided at x = 10 m by a wall with one
door opening of `door-width`. `initial-per-side` pedestrians start on the left
(walking right, orange) and, with `two-sided?`, as many on the right (walking
left, blue). `spawn-rate` adds arrivals at the ends. Everyone steers for the
middle of the door (a waypoint) and then for a random point at the far end.

## WHAT TO LOOK FOR

Expected: pedestrians slow down or wait while someone is in the door; with a
crowd on both sides, passages alternate between directions. `alternation` is
the fraction of consecutive passages that change direction (1 = strict
alternation). `waiting at door` counts people standing still within 3 m of it.

## DOOR WIDTH AND THE WALL FORCE

With the paper's wall force 50 exp(-d / 0.2) m/s^2, both door posts push back
on someone walking through the middle of a narrow opening. For an opening of
0.8 m the peak push-back is about 5.0 m/s^2, larger than the driving force
v0 / tau = 2.68 m/s^2 of an average walker, so a lone pedestrian stops in
front of it. The peak falls below 2.68 m/s^2 at about 1.0 m (2.79 at 1.0 m,
2.09 at 1.1 m).

Historical results before the hard pair constraint, measured with
`door-width-sweep` (20 per side, both directions, seeds 1-3,
180 s limit): 0.8-0.9 m: blocked (0-1 passages); 1.0 m: 7-9 of 40 pass;
1.1-1.2 m: 24-38 of 40 pass, the counterflow jams and the corridor never
empties; 1.4 m: empties in 68-79 s with alternation about 0.7; 1.6 m:
45-56 s. The default 1.2 m lets a lone walker through one at a time (centres
must stay 0.2 m from each post). At every passable width the crowd pressing
at the door squeezes people to 0.10-0.20 m apart, and a few pass-throughs
occurred: the soft pair repulsion alone does not stop crowd pressure.
The current 0.5 m constraint prevents these overlaps; these historical flow
and alternation figures must be remeasured with the constraint enabled.

## SHARED MODEL

Forces, integration and walls come from `../core/pedestrians.nls`; correctness
checks from `../core/checks.nls`; statistics, plots and CSV logging from
`../core/stats.nls`. Every wall segment exerts the paper's wall force and is
impenetrable (centres stay `body-radius` = 0.2 m away). `../core/contact.nls`
adds a joint hard 0.5 m centre-to-centre constraint along the whole step.
This supplements the unchanged social forces and may produce queues or jams.

## CORRECTNESS CHECKS

With `run-checks?` on, every step updates: `pass-throughs` (deep swept closest
approaches below 0.2 m in any direction), `min separation seen`, wall clearance
and speed-cap violations (|v| > 1.3 v0). `overlapping pairs` counts drawn
circles overlapping now. With the default pair constraint enabled, minimum
separation stays at least 0.5 m within numerical tolerance and both counts
remain zero. `contact-solver-fallbacks` counts safe stops if the solver stalls.

## LOGGING

With `log-csv?` on, setup writes `../work/<scenario>.csv` (create the `work`
folder first): every 0.1 s, the mean, standard deviation and sample variance
of speed, speed / desired speed, forward speed, sideways speed and completed
travel times.
]]></info>
  <turtleShapes>
    <shape name="default" rotatable="false" editableColorIndex="0">
      <circle x="0" y="0" diameter="300" filled="true" marked="true" color="-1920102913" />
    </shape>
    <shape name="circle" rotatable="false" editableColorIndex="0">
      <circle x="0" y="0" diameter="300" filled="true" marked="true" color="-1920102913" />
    </shape>
  </turtleShapes>
  <linkShapes />
  <previewCommands>setup repeat 1500 [go]</previewCommands>
  <experiments>
    <experiment name="door-width-sweep" repetitions="1" sequentialRunOrder="true" runMetricsEveryStep="false" timeLimit="9000">
      <setup>setup</setup>
      <go>go</go>
      <exitCondition>not any? pedestrians</exitCondition>
      <metrics>
        <metric>elapsed-seconds</metric>
        <metric>emptied-seconds</metric>
        <metric>arrived-count</metric>
        <metric>count pedestrians</metric>
        <metric>door-passes</metric>
        <metric>alternation-fraction</metric>
        <metric>door-flow</metric>
        <metric>pass-through-events</metric>
        <metric>worst-min-separation</metric>
        <metric>worst-wall-clearance</metric>
        <metric>speed-cap-violations</metric>
        <metric>wall-penetration-count</metric>
      </metrics>
      <constants>
        <enumeratedValueSet variable="relative-anticipation?">
            <value value="true"></value>
          </enumeratedValueSet>
        <enumeratedValueSet variable="noise-strength">
            <value value="0"></value>
          </enumeratedValueSet>
        <enumeratedValueSet variable="dt">
            <value value="0.02"></value>
          </enumeratedValueSet>
        <enumeratedValueSet variable="run-checks?">
            <value value="true"></value>
          </enumeratedValueSet>
        <enumeratedValueSet variable="log-csv?">
            <value value="false"></value>
          </enumeratedValueSet>
        <enumeratedValueSet variable="show-trails?">
            <value value="false"></value>
          </enumeratedValueSet>
        <enumeratedValueSet variable="mean-desired-speed">
            <value value="1.34"></value>
          </enumeratedValueSet>
        <enumeratedValueSet variable="desired-speed-sd">
            <value value="0.26"></value>
          </enumeratedValueSet>
        <enumeratedValueSet variable="initial-per-side">
            <value value="20"></value>
          </enumeratedValueSet>
        <enumeratedValueSet variable="spawn-rate">
            <value value="0"></value>
          </enumeratedValueSet>
        <enumeratedValueSet variable="two-sided?">
            <value value="true"></value>
          </enumeratedValueSet>
        <enumeratedValueSet variable="room-width">
            <value value="6"></value>
          </enumeratedValueSet>
      </constants>
      <subExperiments>
        <subExperiment>
          <enumeratedValueSet variable="door-width">
            <value value="0.8"></value>
            <value value="0.9"></value>
            <value value="1.0"></value>
            <value value="1.1"></value>
            <value value="1.2"></value>
            <value value="1.4"></value>
            <value value="1.6"></value>
          </enumeratedValueSet>
          <enumeratedValueSet variable="simulation-seed">
            <value value="1"></value>
            <value value="2"></value>
            <value value="3"></value>
          </enumeratedValueSet>
        </subExperiment>
      </subExperiments>
    </experiment>
  </experiments>
</model>
