    <slider x="10" y="115" width="235" height="50" display="mean-desired-speed" variable="mean-desired-speed" min="0.2" max="2.0" step="0.02" default="1.34" direction="Horizontal" units="m/s" />
    <slider x="10" y="170" width="235" height="50" display="desired-speed-sd" variable="desired-speed-sd" min="0" max="0.8" step="0.01" default="0.26" direction="Horizontal" units="m/s" />
    <slider x="10" y="225" width="235" height="50" display="noise-strength" variable="noise-strength" min="0" max="0.2" step="0.005" default="0" direction="Horizontal" units="m/s^2" />
    <slider x="10" y="280" width="235" height="50" display="simulation-seed" variable="simulation-seed" min="0" max="1000" step="1" default="42" direction="Horizontal" units="setup" />
    <switch x="10" y="335" width="235" height="40" on="true" variable="relative-anticipation?" display="relative-anticipation?" />
    <switch x="10" y="380" width="235" height="40" on="true" variable="run-checks?" display="run-checks?" />
    <switch x="10" y="425" width="235" height="40" on="false" variable="show-trails?" display="show-trails?" />
    <switch x="10" y="470" width="235" height="40" on="false" variable="log-csv?" display="log-csv?" />
    <slider x="10" y="520" width="235" height="50" display="switch-time" variable="switch-time" min="2" max="60" step="1" default="20" direction="Horizontal" units="s" />
    <switch x="10" y="575" width="235" height="40" on="false" variable="start-green?" display="start-green?" />
    <slider x="10" y="620" width="235" height="50" display="road-width" variable="road-width" min="2" max="12" step="0.5" default="6" direction="Horizontal" units="m" />
    <slider x="10" y="675" width="235" height="50" display="walkway-width" variable="walkway-width" min="3" max="12" step="0.5" default="6" direction="Horizontal" units="m" />
    <slider x="10" y="730" width="235" height="50" display="initial-per-side" variable="initial-per-side" min="0" max="40" step="1" default="10" direction="Horizontal" units="people" />
    <slider x="10" y="785" width="235" height="50" display="spawn-rate" variable="spawn-rate" min="0" max="3" step="0.1" default="0.5" direction="Horizontal" units="attempts/s" />
    <monitor x="265" y="229" width="150" height="55" display="simulated seconds" precision="2" fontSize="11">elapsed-seconds</monitor>
    <monitor x="425" y="229" width="150" height="55" display="walking" precision="0" fontSize="11">count pedestrians</monitor>
    <monitor x="585" y="229" width="150" height="55" display="arrived" precision="0" fontSize="11">arrived-count</monitor>
    <monitor x="745" y="229" width="150" height="55" display="returned" precision="0" fontSize="11">returned-count</monitor>
    <monitor x="905" y="229" width="150" height="55" display="blocked arrivals" precision="0" fontSize="11">blocked-spawn-count</monitor>
    <monitor x="265" y="289" width="150" height="55" display="mean speed (m/s)" precision="3" fontSize="11">stat-mean speeds</monitor>
    <monitor x="425" y="289" width="150" height="55" display="overlapping pairs" precision="0" fontSize="11">overlap-pair-count</monitor>
    <monitor x="585" y="289" width="150" height="55" display="pass-throughs" precision="0" fontSize="11">pass-through-events</monitor>
    <monitor x="745" y="289" width="150" height="55" display="wall penetrations" precision="0" fontSize="11">wall-penetration-count</monitor>
    <monitor x="905" y="289" width="150" height="55" display="min separation seen" precision="3" fontSize="11">ifelse-value (worst-min-separation &gt; 1e8) ["-"] [worst-min-separation]</monitor>
    <monitor x="265" y="349" width="150" height="55" display="light" precision="0" fontSize="11">light-colour</monitor>
    <monitor x="425" y="349" width="150" height="55" display="switches" precision="0" fontSize="11">light-switches</monitor>
    <monitor x="585" y="349" width="150" height="55" display="waiting" precision="0" fontSize="11">waiting-count</monitor>
    <monitor x="745" y="349" width="150" height="55" display="mean gap to line (m)" precision="3" fontSize="11">mean-waiting-gap</monitor>
    <monitor x="905" y="349" width="150" height="55" display="max overshoot (m)" precision="3" fontSize="11">max-stop-overshoot</monitor>
    <monitor x="265" y="409" width="150" height="55" display="held on road" precision="0" fontSize="11">held-on-road-count</monitor>
    <plot x="265" y="479" width="400" height="200" display="speed (m/s): mean +/- sd" xAxis="simulated seconds" yAxis="m/s" xMin="0.0" xMax="10.0" yMin="0.0" yMax="1.0" autoPlotX="true" autoPlotY="true" legend="true">
      <setup></setup>
      <update>plot-mean-sd speeds</update>
      <pen display="mean" interval="1.0" mode="0" color="-16777216" legend="true">
        <setup></setup>
        <update></update>
      </pen>
      <pen display="+sd" interval="1.0" mode="0" color="-7500403" legend="true">
        <setup></setup>
        <update></update>
      </pen>
      <pen display="-sd" interval="1.0" mode="0" color="-7500403" legend="true">
        <setup></setup>
        <update></update>
      </pen>
    </plot>
    <plot x="675" y="479" width="400" height="200" display="speed / desired speed" xAxis="simulated seconds" yAxis="ratio" xMin="0.0" xMax="10.0" yMin="0.0" yMax="1.0" autoPlotX="true" autoPlotY="true" legend="true">
      <setup></setup>
      <update>plot-mean-sd speed-ratios</update>
      <pen display="mean" interval="1.0" mode="0" color="-16777216" legend="true">
        <setup></setup>
        <update></update>
      </pen>
      <pen display="+sd" interval="1.0" mode="0" color="-7500403" legend="true">
        <setup></setup>
        <update></update>
      </pen>
      <pen display="-sd" interval="1.0" mode="0" color="-7500403" legend="true">
        <setup></setup>
        <update></update>
      </pen>
    </plot>
    <plot x="265" y="689" width="400" height="200" display="light and queue" xAxis="simulated seconds" yAxis="count" xMin="0.0" xMax="10.0" yMin="0.0" yMax="1.0" autoPlotX="true" autoPlotY="true" legend="true">
      <setup></setup>
      <update></update>
      <pen display="waiting" interval="1.0" mode="0" color="-2674135" legend="true">
        <setup></setup>
        <update>if stats-sample? [plotxy elapsed-seconds waiting-count]</update>
      </pen>
      <pen display="green (x5)" interval="1.0" mode="0" color="-10899396" legend="true">
        <setup></setup>
        <update>if stats-sample? [plotxy elapsed-seconds ifelse-value light-green? [5] [0]]</update>
      </pen>
    </plot>
  </widgets>
  <info><![CDATA[## WHAT IS IT?

A 40 m walkway is crossed in the middle by a road (`road-width`, darker
grey) with a pedestrian light shown in the strips beside both curbs. The
light has a colour (green or red) and a `switch-time`: the number of seconds
before it changes colour. `start-green?` sets the first colour.
Pedestrians walk both ways (orange right, blue left).

## HOW THE LIGHT ACTS

When the light is red, every pedestrian who has not yet passed its stop
line (body touching the near curb) gets a stop line. Within about 2.7 m of it
the desired speed becomes gap / (4 tau): together with the paper's relaxation
term this gives critical damping for isolated, uncapped, one-dimensional
motion. That alone does not prevent overshoot for arbitrary incoming speeds
or crowd pressure. An explicit stop-line boundary prevents a held pedestrian
from crossing the line and removes inward preferred velocity, then reapplies
the unchanged speed cap. This boundary and the braking target are scenario
rules in addition to the paper's social-force equations. Pedestrians already
past their line when it turns red finish crossing. On green the stop lines are removed and
the driving term accelerates everyone back towards their desired speed.

A step that straddles a light change is split at the exact switching time.
Both substeps update all pedestrians synchronously; their durations add to
the selected dt, which is restored after go. The tick counter counts these
integration substeps; elapsed-seconds is the physical simulation time.

## WHAT TO LOOK FOR

Expected: on red, pedestrians slow down and queue just before the curb
(`mean gap to line`, small and positive); `max overshoot` and `held on road`
stay near zero; on green the speed ratio returns to about 1.

## SHARED MODEL

Forces, integration and walls come from `../core/pedestrians.nls`; correctness
checks from `../core/checks.nls`; statistics, plots and CSV logging from
`../core/stats.nls`. Every wall segment exerts the paper's wall force and is
impenetrable (centres stay `body-radius` = 0.2 m away). `../core/contact.nls`
adds a joint hard 0.5 m centre-to-centre constraint along the whole step.
This supplements the unchanged social forces and may produce queues or jams.

## CORRECTNESS CHECKS

With `run-checks?` on, every step updates: `pass-throughs` (deep swept closest
approaches below 0.2 m in any direction), `min separation seen`, wall clearance
and speed-cap violations (|v| > 1.3 v0). `overlapping pairs` counts drawn
circles overlapping now. With the default pair constraint enabled, minimum
separation stays at least 0.5 m within numerical tolerance and both counts
remain zero. `contact-solver-fallbacks` counts safe stops if the solver stalls.

## LOGGING

With `log-csv?` on, setup writes `../work/<scenario>.csv` (create the `work`
folder first): every 0.1 s, the mean, standard deviation and sample variance
of speed, speed / desired speed, forward speed, sideways speed and completed
travel times.
]]></info>
