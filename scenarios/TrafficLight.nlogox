<?xml version="1.0" encoding="utf-8"?>
<model version="NetLogo 7.0.4" snapToGrid="true">
  <code><![CDATA[; =============================================================================
; scenarios/TrafficLight.nlogox -- traffic-light scenario
; =============================================================================
; Traffic-light scenario: a walkway crossed by a road with a pedestrian light.
; While the light is red, pedestrians who have not reached their curb brake
; to a stop at it; when it turns green they continue. Pedestrians already on
; the road when it turns red finish crossing.
; Shared model: ../core/pedestrians.nls (stop lines use its stop-x option).
; Interface variables: dt, mean-desired-speed, desired-speed-sd,
; noise-strength, simulation-seed, show-trails?, relative-anticipation?,
; run-checks?, log-csv?, switch-time, start-green?, road-width,
; walkway-width, spawn-rate, initial-per-side.
;
; Geometry (metres): a 40 m long walkway, walkway-width wide, with a road of
; road-width centred at x = 20 (light grey). No cars are modelled; the road
; only defines where the curbs (stop lines) are.
;
; The light switches colour every switch-time simulated seconds. A red light
; gives each pedestrian still before its curb a stop-x: the core then brakes
; it smoothly towards that line and never lets its centre cross it.

__includes [ "../core/pedestrians.nls" "../core/contact.nls" "../core/checks.nls" "../core/stats.nls" ]

globals [
  road-left road-right    ; road edges (curbs), metres
  light-green?            ; the light's colour: true = green, false = red
  light-timer             ; seconds since the last switch
  light-switches          ; number of colour changes so far
  max-stop-overshoot      ; furthest a held pedestrian got past its stop line (m)
]

; Build the walkway and road, set the light and place both initial crowds.
to setup
  clear-all
  ped-init-constants
  checks-reset
  stats-reset
  if road-width >= 30 [error "road-width must be less than 30 m."]
  set hall-length 40
  set hall-bottom 1.5
  set hall-top hall-bottom + walkway-width
  set open-left 1
  set open-right hall-length - 1
  set road-left hall-length / 2 - road-width / 2
  set road-right hall-length / 2 + road-width / 2
  resize-world 0 hall-length 0 (ceiling (hall-top + 1.5))
  set-topology false false
  set wall-segments (list (list 0 hall-bottom hall-length hall-bottom)
                          (list 0 hall-top hall-length hall-top))
  ; White sidewalk, light grey road, dark grey outside the walls.
  ask patches [
    set pcolor white
    if pxcor >= road-left and pxcor <= road-right [set pcolor gray + 2]
    if pycor < hall-bottom or pycor > hall-top [set pcolor gray - 2]
  ]
  draw-walls black
  set light-green? start-green?
  set light-timer 0
  set light-switches 0
  set max-stop-overshoot 0
  draw-light
  random-seed simulation-seed
  ; Both directions start on their own sidewalk.
  place-initial-crowd 1
  place-initial-crowd -1
  if log-csv? [log-start "../work/traffic-light.csv"]
  reset-ticks
end

; Advance the simulation by dt seconds. If the light changes inside this
; interval, the interval is split into substeps at the exact switch time.
to go
  ped-check-parameters
  if spawn-rate < 0 [error "spawn-rate must not be negative."]
  if switch-time <= 0 [error "switch-time must be positive."]
  ; dt is temporarily shortened for substeps below and restored at the end.
  let requested-dt dt
  let finish-time elapsed-seconds + requested-dt
  repeat random-poisson (spawn-rate * requested-dt) [spawn-at-entrance]
  ; A light change is an exact event: finish the current colour's interval,
  ; then integrate any remainder under the new colour. All pedestrians still
  ; update synchronously within each substep.
  update-light
  while [elapsed-seconds < finish-time - 1e-10] [
    ; Step to whichever comes first: the end of dt or the next light switch.
    set dt min (list (finish-time - elapsed-seconds) (switch-time - light-timer))
    ped-step
    set light-timer light-timer + dt
    track-stop-lines
    if run-checks? [checks-update]
    log-row
    update-light
  ]
  set dt requested-dt
end

; Hook required by core/pedestrians.nls.
; Leave through the far exit plane; pushed back through the entrance = returned.
to scenario-exit-check
  x-walkway-exit-check
end

; Switch the light when its timer has run out, then give or remove stop lines.
to update-light
  ; A while loop (not if) handles several switches in one call; the timer
  ; keeps its remainder so the cycle never drifts.
  while [light-timer >= switch-time - 1e-10] [
    set light-green? not light-green?
    set light-timer max (list 0 (light-timer - switch-time))
    set light-switches light-switches + 1
    draw-light
  ]
  foreach sort pedestrians [p -> ask p [
    ifelse light-green?
      [set stop-x false]
      ; Only those still before their stop line are held; anyone past it
      ; (already on or at the road) completes the crossing.
      [if stop-x = false and gap-to-stop-line >= 0 [set stop-x own-stop-line]]
  ]]
end

; The centre stops body-radius before the curb, i.e. the body touches it.
to-report own-stop-line  ; pedestrian reporter
  report ifelse-value (travel-direction = 1)
    [road-left - body-radius] [road-right + body-radius]
end

; Distance still to walk to the stop line (negative once past it).
to-report gap-to-stop-line  ; pedestrian reporter
  report (own-stop-line - xcor) * travel-direction
end

; Correctness check: how far past its stop line any held pedestrian has got.
; Should stay 0 (the core enforces the line as a hard boundary).
to track-stop-lines
  foreach sort (pedestrians with [is-number? stop-x]) [p -> ask p [
    set max-stop-overshoot max (list max-stop-overshoot (- gap-to-stop-line))
  ]]
end

; The light is shown on both curbs, in the grey strips outside the walls.
to draw-light
  foreach sort (patches with [(pycor < hall-bottom or pycor > hall-top) and
                    (pxcor = floor road-left or pxcor = ceiling road-right)])
    [p -> ask p [set pcolor ifelse-value light-green? [green] [red]]]
end

; initial-per-side pedestrians scattered over one sidewalk.
to place-initial-crowd [direction]
  ; Each direction starts on its own sidewalk, before the road.
  let low ifelse-value (direction = 1) [open-left + 0.5] [road-right + 1]
  let high ifelse-value (direction = 1) [road-left - 1] [open-right - 0.5]
  repeat initial-per-side [
    let spot try-place [-> (list random-between low high random-walkway-y)] 2000
    if spot = false
      [error "Could not place the initial crowd with clearance. Reduce initial-per-side."]
    add-pedestrian item 0 spot item 1 spot direction
  ]
end

; Create one arrival at a random end, if there is room for it.
to spawn-at-entrance
  let direction ifelse-value (random 2 = 0) [1] [-1]
  let entrance-x ifelse-value (direction = 1) [open-left] [open-right]
  let spot try-place [-> (list entrance-x random-walkway-y)] 20
  ifelse spot = false
    [set blocked-spawn-count blocked-spawn-count + 1]
    [add-pedestrian item 0 spot item 1 spot direction]
end

; Random y inside the walkway, at least 0.75 m from either wall.
to-report random-walkway-y
  report random-between (hall-bottom + 0.75) (hall-top - 0.75)
end

; A pedestrian walking to the far exit at a random y. Stop lines are given
; by update-light, not here.
to add-pedestrian [x y direction]
  let target-y random-walkway-y
  create-pedestrians 1 [
    initialize-pedestrian x y (ifelse-value (direction = 1) [open-right] [open-left])
      target-y direction
  ]
  set spawned-count spawned-count + 1
end

; "green" or "red", for the interface monitor.
to-report light-colour
  report ifelse-value light-green? ["green"] ["red"]
end

; Held pedestrians standing still: the queue at the light.
to-report waiting-count
  report count pedestrians with [is-number? stop-x and vector-length vx vy < stop-speed]
end

; Mean distance of waiting pedestrians from their stop line (m).
to-report mean-waiting-gap
  let waiting pedestrians with [is-number? stop-x and vector-length vx vy < stop-speed]
  if not any? waiting [report 0]
  report mean map [p -> [gap-to-stop-line] of p] sort waiting
end

; Held pedestrians whose centre is on the road (should stay 0).
to-report held-on-road-count
  report count pedestrians with [is-number? stop-x and xcor > road-left and xcor < road-right]
end
]]></code>
  <widgets>
    <view x="265" y="10" width="824" height="204" patchSize="20" minPxcor="0" maxPxcor="40" minPycor="0" maxPycor="9" wrappingAllowedX="false" wrappingAllowedY="false" frameRate="30" fontSize="12" showTickCounter="true" tickCounterLabel="steps" updateMode="1" />
    <button x="10" y="10" width="75" height="40" display="setup" kind="Observer" forever="false" disableUntilTicks="false">setup</button>
