  <linkShapes />
  <previewCommands>setup repeat 1500 [go]</previewCommands>
  <experiments>
    <experiment name="light-cycle" repetitions="1" sequentialRunOrder="true" runMetricsEveryStep="false" timeLimit="6000">
      <setup>setup</setup>
      <go>go</go>
      <runMetricsCondition>ticks mod 25 = 0</runMetricsCondition>
      <metrics>
        <metric>elapsed-seconds</metric>
        <metric>light-colour</metric>
        <metric>count pedestrians</metric>
        <metric>waiting-count</metric>
        <metric>mean-waiting-gap</metric>
        <metric>max-stop-overshoot</metric>
        <metric>held-on-road-count</metric>
        <metric>stat-mean speed-ratios</metric>
        <metric>stat-sd speed-ratios</metric>
        <metric>stat-variance speed-ratios</metric>
        <metric>pass-through-events</metric>
        <metric>worst-min-separation</metric>
        <metric>worst-wall-clearance</metric>
        <metric>speed-cap-violations</metric>
        <metric>wall-penetration-count</metric>
      </metrics>
      <constants>
        <enumeratedValueSet variable="relative-anticipation?">
            <value value="true"></value>
          </enumeratedValueSet>
        <enumeratedValueSet variable="noise-strength">
            <value value="0"></value>
          </enumeratedValueSet>
        <enumeratedValueSet variable="dt">
            <value value="0.02"></value>
          </enumeratedValueSet>
        <enumeratedValueSet variable="run-checks?">
            <value value="true"></value>
          </enumeratedValueSet>
        <enumeratedValueSet variable="log-csv?">
            <value value="false"></value>
          </enumeratedValueSet>
        <enumeratedValueSet variable="show-trails?">
            <value value="false"></value>
          </enumeratedValueSet>
        <enumeratedValueSet variable="mean-desired-speed">
            <value value="1.34"></value>
          </enumeratedValueSet>
        <enumeratedValueSet variable="desired-speed-sd">
            <value value="0.26"></value>
          </enumeratedValueSet>
        <enumeratedValueSet variable="initial-per-side">
            <value value="10"></value>
          </enumeratedValueSet>
        <enumeratedValueSet variable="spawn-rate">
            <value value="0.5"></value>
          </enumeratedValueSet>
        <enumeratedValueSet variable="start-green?">
            <value value="false"></value>
          </enumeratedValueSet>
        <enumeratedValueSet variable="road-width">
            <value value="6"></value>
          </enumeratedValueSet>
        <enumeratedValueSet variable="walkway-width">
            <value value="6"></value>
          </enumeratedValueSet>
      </constants>
      <subExperiments>
        <subExperiment>
          <enumeratedValueSet variable="switch-time">
            <value value="10"></value>
            <value value="20"></value>
            <value value="30"></value>
          </enumeratedValueSet>
          <enumeratedValueSet variable="simulation-seed">
            <value value="1"></value>
          </enumeratedValueSet>
        </subExperiment>
      </subExperiments>
    </experiment>
  </experiments>
</model>
